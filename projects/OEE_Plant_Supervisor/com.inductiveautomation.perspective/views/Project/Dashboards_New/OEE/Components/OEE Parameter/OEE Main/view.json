      {
        "children": [
          {
            "meta": {
              "name": "Label"
            },
            "position": {
              "basis": "32px",
              "grow": 1
            },
            "props": {
              "style": {
                "borderBottomColor": "--neutral-30",
                "borderBottomStyle": "solid",
                "borderBottomWidth": "1px",
                "marginLeft": "10px",
                "marginRight": "10px"
              },
              "text": "OEE(%)",
              "textStyle": {
                "color": "--neutral-80",
                "fontFamily": "verdana",
                "fontSize": "17px",
                "fontWeight": "bold",
                "textAlign": "center"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "SimpleGauge"
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
              "props.label.color": {
                "binding": {
                  "config": {
                    "path": "session.props.theme"
                  },
                  "transforms": [
                    {
                      "code": "\treturn \u0027#D5D5D5\u0027 if \u0027dark\u0027 in self.session.props.theme else \u0027#2B2B2B\u0027",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              },
              "props.value": {
                "binding": {
                  "config": {
                    "path": "view.params.OEE"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "animate": true,
              "arc": {
                "width": 8
              },
              "endAngle": 580,
              "label": {
                "offsetY": 22,
                "size": 30
              },
              "startAngle": 220,
              "style": {
                "fontWeight": "bold"
              }
            },
            "type": "ia.chart.simple-gauge"
          }
        ],
        "meta": {
          "name": "FlexContainer_2"
        },
        "position": {
          "basis": "200px",
          "grow": 1
