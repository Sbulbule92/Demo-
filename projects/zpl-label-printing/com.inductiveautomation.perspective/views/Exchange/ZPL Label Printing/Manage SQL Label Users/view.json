        "position": {
          "height": 45,
          "width": 135,
          "x": 155,
          "y": 55
        },
        "propConfig": {
          "props.options": {
            "binding": {
              "config": {
                "queryPath": "Exchange/ZPL Label Printing/Get Label Templates",
                "returnFormat": "dataset"
              },
              "type": "query"
            }
          }
        },
        "props": {
          "showClearIcon": true,
          "style": {
            "marginRight": 5
          },
          "value": null
        },
