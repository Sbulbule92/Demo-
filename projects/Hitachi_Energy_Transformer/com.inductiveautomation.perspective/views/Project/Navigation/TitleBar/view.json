    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "openGatewayPopup",
          "pageScope": false,
          "script": "\t# implement your handler here\n\t# implement your handler here\n#    roles \u003dself.session.props.auth.user.roles[0]\n#    if \"Operator\" in roles :\n\tsystem.perspective.openPopup(id\u003d\u002710UI\u0027,view\u003d\u0027Operator/downtime_entry_popup\u0027,showCloseIcon\u003dFalse,modal\u003dTrue)",
          "sessionScope": true,
          "viewScope": false
        },
        {
          "messageType": "logoutOPR",
          "pageScope": false,
          "script": "\t# implement your handler here\n    user\u003dself.session.props.auth.user.userName\n    tagpath\u003d[\"WOCL_1/Downtime/Ideal_time/Start_time\",\"Current_Shift/shift_ID\"]\n    tagvalue\u003dsystem.tag.readBlocking(tagpath)\n    reasondowntime\u003d16\n    user\u003dself.session.props.auth.user.userName\n    inprogressdowntime\u003dFalse\n    starttime\u003dtagvalue[0].value\n    shift\u003dtagvalue[1].value\n    descdowntime\u003d\u0027\u0027\n    parameters \u003d { \"ReasonID\":reasondowntime, \"DowntimeStatus\":not inprogressdowntime,\"username\":user,\"StartTime\":starttime,\"ShiftID\":shift,\"DowntimeSource\":1,\"Remarks\":descdowntime}\n    idreturn\u003dsystem.db.runNamedQuery(\"Hitachi_Energy_Transformer\",\"downtime/insert\", parameters)\n    logId\u003didreturn.getValueAt(0,\"LogID\")\n    system.tag.writeBlocking(tagPaths\u003d[\"WOCL_1/Downtime/Ideal_time/logID\", \"WOCL_1/Downtime/Ideal_time/log_Active\"], values\u003d[logId, 1])\n    system.perspective.logout()",
          "sessionScope": true,
          "viewScope": false
        }
      ]
    },
