        "type": "ia.input.text-area"
      },
      {
        "meta": {
          "name": "LblStep2"
        },
        "position": {
          "height": 45,
          "width": 280,
          "x": 10,
          "y": 560
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "if(\n\t{../DropTemplates.props.value} \u003d \u0027New\u0027\n\t, \u00272. Name and Add Label\u0027 \n\t, \u00272. Delete or Update Label\u0027 \n)"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "textStyle": {
            "textAlign": "center",
            "textDecoration": "underline"
          }
        },
        "type": "ia.display.label"
      },
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\t# confirm deletion\n\tmessage \u003d \u0027Please confirm you wish to delete this label and all users associated with this label.\u0027\n\texchange.zplLabelPrinting.popup.displayConfirmation(message)\n\t\n\t\n\t"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "BtnDeleteLabel"
        },
        "position": {
          "height": 45,
          "width": 135,
          "x": 10,
          "y": 605
        },
        "propConfig": {
          "meta.visible": {
            "binding": {
              "config": {
                "expression": "if(\r\n\t{../DropTemplates.props.value} !\u003d \u0027New\u0027 \r\n\t, true \r\n\t, false \r\n)"
              },
              "type": "expr"
            }
          },
          "props.enabled": {
            "binding": {
              "config": {
                "expression": "if(\r\n\t{../DropTemplates.props.value} !\u003d \u0027New\u0027 \r\n\t, true \r\n\t, false \r\n)"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "classes": "Components/brownButtons"
          },
          "text": "Delete Label"
        },
        "scripts": {
          "customMethods": [],
          "extensionFunctions": null,
          "messageHandlers": [
            {
              "messageType": "exchange.zplLabelPrinting.confirmPopup",
              "pageScope": true,
              "script": "\t# get selected label name and user name\n\tlabelName \u003d self.getSibling(\"DropTemplates\").props.value\n\t\n\t# first get id from label templates table\n\tgetID \u003d \"\"\"\n\t\tselect id \n\t\tfrom ex_zpl_label_printing.ex_zlp_label_templates \n\t\twhere label_name \u003d ?\n\t\"\"\"\n\tlabelID_DS \u003d system.db.runPrepQuery(getID, [labelName], \u0027ex_zpl_label_printing\u0027)\n\tforeignKeyID \u003d labelID_DS.getValueAt(0, \u0027id\u0027)\n\t\n\t# second delete all records from users table for the selected label name (due to foreigh key constraint)\n\tdeleteUser \u003d \"\"\"\n\t\tdelete from ex_zpl_label_printing.ex_zlp_label_users \n\t\twhere ex_zlp_label_templates_id \u003d ? \n\t\"\"\"\n\tr \u003d system.db.runPrepUpdate(deleteUser, [foreignKeyID], \u0027ex_zpl_label_printing\u0027)\n\t\n\t# third delete the label template from the templates table for the selected label name\n\tdeleteTemplate \u003d \"\"\"\n\t\tdelete from ex_zpl_label_printing.ex_zlp_label_templates \n\t\twhere label_name \u003d ? \n\t\"\"\"\n\tr \u003d system.db.runPrepUpdate(deleteTemplate, [labelName], \u0027ex_zpl_label_printing\u0027)\n\t\n\t# refresh the label templates dropdown menu, zpl text area, and label image\n\tsystem.perspective.sendMessage(\u0027exchange.zplLabelPrinting.refreshLabelNames\u0027, scope\u003d\u0027page\u0027)\n\tlabelInfo \u003d {}\n\tlabelInfo[\u0027labelZPL\u0027] \u003d \u0027\u0027\n\tsystem.perspective.sendMessage(\u0027exchange.zplLabelPrinting.getLabelaryImage\u0027, scope\u003d\u0027page\u0027, payload\u003dlabelInfo)\n\t\n\texchange.zplLabelPrinting.popup.displayMessage(\u0027Removed Label\u0027, \u0027Successfully removed label template!\u0027)\n\t\n\t\n\t",
              "sessionScope": false,
              "viewScope": true
            }
          ]
        },
        "type": "ia.input.button"
      },
      {
        "meta": {
          "name": "TextNewLabelName"
        },
        "position": {
          "height": 45,
          "width": 135,
          "x": 10,
          "y": 605
        },
        "propConfig": {
          "meta.visible": {
            "binding": {
              "config": {
                "expression": "// only enable if \u003cNew\u003e template is selected\nif(\n\t{../DropTemplates.props.value} \u003d \u0027New\u0027\n\t, true \n\t, false \n)"
              },
              "type": "expr"
            }
          },
          "props.enabled": {
            "binding": {
              "config": {
                "expression": "// only enable if \u003cNew\u003e template is selected\nif(\n\t{../DropTemplates.props.value} \u003d \u0027New\u0027\n\t, true \n\t, false \n)"
              },
              "type": "expr"
            }
          }
        },
        "type": "ia.input.text-field"
      },
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\t# get label data, and if it is a new label insert the new record, else update the existing record\n\tlabelZPL \u003d self.getSibling(\"TextZpl\").props.text\n\ttemplateName \u003d self.getSibling(\"DropTemplates\").props.value\n\t\n\tif templateName \u003d\u003d \u0027New\u0027:\n\t\t# first check if labelName already exists in database\n\t\tlabelName \u003d self.getSibling(\"TextNewLabelName\").props.text\n\t\t\n\t\tlabelNames \u003d []\n\t\tgetLabelNames \u003d \"\"\"\n\t\t\tselect label_name\n\t\t\tfrom ex_zpl_label_printing.ex_zlp_label_templates \n\t\t\"\"\"\n\t\tlabelNames_DS \u003d system.db.runPrepQuery(getLabelNames, [], \u0027ex_zpl_label_printing\u0027)\n\t\tfor row in range(labelNames_DS.getRowCount()):\n\t\t\tlabelNames.append(labelNames_DS.getValueAt(row, \u0027label_name\u0027))\n\t\t\n\t\t# display error if name already exists; otherwise add new record\n\t\tif labelName in labelNames:\n\t\t\texchange.zplLabelPrinting.popup.displayError(\u0027label name already exists in database!\u0027)\n\t\t\t\n\t\telse:\n\t\t\taddLabel \u003d \"\"\"\n\t\t\t\tinsert into ex_zpl_label_printing.ex_zlp_label_templates \n\t\t\t\t(label_name, label_zpl)\n\t\t\t\tvalues (?, ?)\n\t\t\t\"\"\"\n\t\t\tr \u003d system.db.runPrepUpdate(addLabel, [labelName, labelZPL], \u0027ex_zpl_label_printing\u0027)\n\t\t\t\n\t\t\tself.getSibling(\"DropTemplates\").props.value \u003d labelName\n\t\t\texchange.zplLabelPrinting.popup.displayMessage(\u0027Added Label\u0027, \u0027Successfully created new label template!\u0027)\n\t\t\t\n\telse: # if the selected template is not \"New\" this is an update\n\t\tlabelName \u003d templateName\n\t\tupdateLabel \u003d \"\"\"\n\t\t\tupdate ex_zpl_label_printing.ex_zlp_label_templates \n\t\t\tset label_zpl \u003d ?\n\t\t\twhere label_name \u003d ?\n\t\t\"\"\"\n\t\tr \u003d system.db.runPrepUpdate(updateLabel, [labelZPL, labelName], \u0027ex_zpl_label_printing\u0027)\n\t\t\n\t\texchange.zplLabelPrinting.popup.displayMessage(\u0027Updated Label\u0027, \u0027Successfully updated label template!\u0027)\n\t\n\t# finally refresh the dropdown menu and the label image\n\tsystem.perspective.sendMessage(\u0027exchange.zplLabelPrinting.refreshLabelNames\u0027, scope\u003d\u0027page\u0027)\n\t\n\tlabelInfo \u003d {}\n\tlabelInfo[\u0027labelZPL\u0027] \u003d labelZPL\n\tsystem.perspective.sendMessage(\u0027exchange.zplLabelPrinting.getLabelaryImage\u0027, scope\u003d\u0027page\u0027, payload\u003dlabelInfo)\n\t\n\t\n\t"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "BtnAddUpdateLabel"
        },
        "position": {
          "height": 45,
