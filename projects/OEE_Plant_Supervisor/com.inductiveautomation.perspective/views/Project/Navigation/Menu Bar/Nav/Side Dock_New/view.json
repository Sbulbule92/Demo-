  "params": {},
  "propConfig": {
    "custom.alerts": {
      "binding": {
        "config": {
          "expression": "now(500)"
        },
        "transforms": [
          {
            "code": "    dt \u003d system.date.now()\n    timeLimit \u003d system.date.addHours(dt, -24)\n    props \u003d [(\"eventtime\", \"\u003e\", timeLimit)]\n#    ackAlarms   \u003d system.alarm.queryStatus(state \u003d [\"ActiveAcked\"], path \u003d [\"*Press*\"], any_properties \u003d props)\n    \n    alarms \u003d system.alarm.queryStatus(state \u003d \"ActiveUnacked\", any_properties \u003d props).getDataset()\n    if alarms.getRowCount()\u003e0:\n    \tsystem.perspective.openPopup(id \u003d \"PopUpCancel\",\n\t\t\t\t\t\t\t\t\tview \u003d \"Project/Supervisor/Job Cancell/jobCancelTable\",\n\t\t\t\t\t\t\t\t\tshowCloseIcon \u003d False,\n\t\t\t\t\t\t\t\t\tdraggable \u003d False,\n\t\t\t\t\t\t\t\t\tmodal \u003d True)\n    return int(alarms.getRowCount()) + int(self.session.custom.activeAlarms)\n#    self.parent.custom.activeAlmNo \u003d alarms.getRowCount()\n#    return True if alarms.getRowCount()\u003e0 else False",
            "type": "script"
          }
        ],
        "type": "expr"
      },
      "persistent": true
    },
    "custom.display": {
      "persistent": true
    },
    "props.defaultSize.width": {
      "binding": {
        "config": {
          "path": "view.custom.display"
        },
        "transforms": [
          {
            "code": "\treturn 230 if value else 80",
            "type": "script"
          }
        ],
        "type": "property"
      }
    }
  },
  "props": {
    "defaultSize": {
      "height": 768
    }
  },
