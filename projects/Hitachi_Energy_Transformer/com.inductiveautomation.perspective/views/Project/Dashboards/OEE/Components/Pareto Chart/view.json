                    "returnFormat": "json"
                  },
                  "transforms": [
                    {
                      "code": "\timport random\n\treason \u003d sorted(\n    random.sample(range(0, 14), 9),\n    reverse\u003dTrue\n\t)\n\treason_count \u003d sorted(\n    random.sample(range(10, 30), 9),\n    reverse\u003dTrue\n\t)\n\tduration \u003d sorted(\n    random.sample(range(30, 65), 9),\n    reverse\u003dTrue\n\t)\n\tdata \u003d []\n\t\n\tfor i in range(1,9):\n#\t\treason \u003d random.randint(0, 14)\n#\t\tduration \u003d random.randint(300,650)\n#\t\treason_count \u003d random.randint(10,43)\n\t\trow \u003d {\"duration\": duration[i], \"reason_count\": reason_count[i], \"reason\":self.view.custom.reasons[reason[i]].ReasonName}\n\t\tdata.append(row)\n\tsorted_data \u003d sorted(data, key\u003dlambda item: item[\u0027duration\u0027], reverse \u003d True)\n\tvalue \u003d sorted_data\n\ttotal \u003d sum(int(v[\u0027duration\u0027]) for v in value)\n\tcum \u003d 0\n\t\n\tfor v in value:\n\t\tv[\u0027reason_count\u0027] \u003d v[\u0027duration\u0027] \n\t\tcum +\u003d round((float(v[\u0027duration\u0027]) / total) * 100, 2)\n\t\tv[\u0027duration\u0027] \u003d cum\n\t\tv[\u0027target\u0027] \u003d 88\n\t\n\treturn value",
                      "type": "script"
                    }
                  ],
