  "propConfig": {
    "custom.database": {
      "binding": {
        "config": {
          "path": "/root.meta.name"
        },
        "transforms": [
          {
            "code": "\treturn exchange.launchpad.oee.DATABASE_NAME\n\t",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.downtimeBars": {
      "binding": {
        "config": {
          "path": "view.custom.historicalData"
        },
        "transforms": [
          {
            "code": "\tinstances \u003d []\n\tfor row in value:\n\t\tinstance \u003d {\n\t\t  \"format\": \"##.0%\",\n\t\t  \"high\": 1,\n\t\t  \"low\": 0,\n\t\t  \"title\": row.line_name,\n\t\t  \"units\": \"\",\n\t\t  \"value\": row.down_minutes/row.minutes_elapsed\n\t\t \n\t\t}\n\t\tinstances.append(instance)\n\n\treturn instances",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.historicalData": {
      "binding": {
        "config": {
          "parameters": {
            "database": "{view.custom.database}",
            "line_name": "\"\"",
            "start_time": "{session.custom.exchange.launchpad.oee.display.startTime}",
            "stop_time": "{session.custom.exchange.launchpad.oee.display.stopTime}",
            "tag_folder": "{view.custom.tagFolder}"
          },
          "queryPath": "Exchange/Launchpad/Oee/HourlyStatsAverage",
          "returnFormat": "json"
        },
        "type": "query"
      },
      "persistent": true
    },
    "custom.oeeBars": {
      "binding": {
        "config": {
          "path": "view.custom.historicalData"
        },
        "transforms": [
          {
            "code": "\tinstances \u003d []\n\tfor row in value:\n\t\tinstance \u003d {\n\t\t  \"format\": \"##.0%\",\n\t\t  \"high\": 1,\n\t\t  \"low\": 0,\n\t\t  \"title\": row.line_name,\n\t\t  \"units\": \"\",\n\t\t  \"value\": row.oee\n\t\t}\n\t\tinstances.append(instance)\n\n\treturn instances",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.tagFolder": {
      "binding": {
        "config": {
          "expression": "now(0)"
        },
        "transforms": [
          {
            "code": "\treturn exchange.launchpad.oee.BASE_TAG_FOLDER",
            "type": "script"
          }
        ],
        "type": "expr"
      },
      "persistent": true
    }
  },
