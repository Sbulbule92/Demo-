{
  "custom": {},
  "params": {
    "tabKey": "",
    "value": {}
  },
  "propConfig": {
    "params.tabKey": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 40,
      "width": 130
    }
  },
  "root": {
    "children": [
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\tconfig_admin.openForm(self.view.params.tabKey, dict(self.view.params.value))"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "editIcon"
        },
        "position": {
          "basis": "26px"
        },
        "props": {
          "color": "#2563eb",
          "path": "material/edit",
          "style": {
            "cursor": "pointer",
            "height": "22px",
            "width": "22px"
          }
        },
        "type": "ia.display.icon"
      },
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\tconfig_admin.confirmDelete(self.view.params.tabKey, dict(self.view.params.value))"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "delIcon"
        },
        "position": {
          "basis": "26px"
        },
        "props": {
          "color": "#dc2626",
          "path": "material/delete",
          "style": {
            "cursor": "pointer",
            "height": "22px",
            "width": "22px"
          }
        },
        "type": "ia.display.icon"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "alignItems": "center",
      "justify": "space-evenly",
      "style": {
        "gap": "10px"
      }
    },
    "type": "ia.container.flex"
  }
}