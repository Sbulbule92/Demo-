                      "transforms": [
                        {
                          "code": "\toptions \u003d []\n\tfor row in range(value.rowCount):\n\t\toption \u003d {\n\t\t  \"value\": value.getValueAt(row,\"rate_name\"),\n\t\t  \"label\": \"%s: %s %s /%s\" %(value.getValueAt(row,\"rate_name\"), value.getValueAt(row,\"target_rate\") ,value.getValueAt(row,\"uom\"), value.getValueAt(row,\"interval\"))\n\t\t}\n\t\toptions.append(option)\n\treturn options",
                          "type": "script"
                        }
                      ],
                      "type": "property"
                    }
