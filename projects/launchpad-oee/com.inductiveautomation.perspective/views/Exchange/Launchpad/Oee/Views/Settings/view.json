                        "marginBottom": 5,
                        "marginTop": 5
                      }
                    },
                    "type": "ia.input.text-field"
                  },
                  {
                    "events": {
                      "component": {
                        "onActionPerformed": {
                          "config": {
                            "script": "\timport time\n\t\n\ttry:\n\t\tself.props.enabled \u003d False\n\t\tself.getSibling(\"PleaseWait\").meta.visible \u003d True\n\t\t#create database tables\n\t\texchange.launchpad.oee.initTables()\n\t\t#if using demo tags then reset the counters and generate mock history\n\t\tif self.session.custom.exchange.launchpad.oee.lineTagFolder \u003d\u003d \"[default]Exchange/Launchpad/Oee/Demo\":\n\t\t\texchange.launchpad.oee.resetDemoTags()\t\t\n\t\t\t\n\t\t\tfor ln in range(1,8):\n\t\t\t\texchange.launchpad.oee.makeHistory(\"Line %d\" %ln)\n\t\t\t\t\n\t\t\texchange.launchpad.oee.initDemoTags()\n\t\t\ttime.sleep(1)\n\t\t\texchange.launchpad.oee.initDemoTags()\n\t\t#refresh\n\t\tself.refreshBinding(\"custom.tableCheck\")\n\n\t\ttime.sleep(1)\n\n\t\tsystem.perspective.sendMessage(\"exchange-launchpad-oee-refresh-rates\", payload\u003d{}, scope\u003d\"page\")\n\t\n\t\t\n\t\t\n\texcept:\n\t\tself.props.enabled \u003d True\n\t\tself.getSibling(\"PleaseWait\").meta.visible \u003d False\n\t\t\n\t\traise\n\tfinally:\n\t\tself.props.enabled \u003d True\n\t\tself.getSibling(\"PleaseWait\").meta.visible \u003d False\n\t\t"
                          },
                          "scope": "G",
                          "type": "script"
                        }
                      }
