                "borderBottomRightRadius": "10px",
                "borderColor": "--error",
                "borderStyle": "solid",
                "borderTopLeftRadius": "10px",
                "borderTopRightRadius": "10px",
                "borderWidth": "2px",
                "margin-top": "10px",
                "marginBottom": "15px",
