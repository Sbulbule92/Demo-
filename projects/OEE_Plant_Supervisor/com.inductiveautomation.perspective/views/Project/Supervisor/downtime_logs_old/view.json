      "persistent": true
    },
    "custom.reasons": {
      "binding": {
        "config": {
          "queryPath": "downtime/GetDowntimeReasonCodes",
          "returnFormat": "json"
        },
        "transforms": [
          {
            "code": "\tdata \u003d []\n\tfor item in value:\n\t\treason \u003d {\"ReasonName\": item[\"label\"]}\n\t\tdata.append(reason)\n\treturn data",
            "type": "script"
          }
        ],
        "type": "query"
      },
      "persistent": true
    },
    "custom.shift": {
      "binding": {
        "config": {
          "path": "/root/FlexContainer_0/EmbeddedView.props.params.shift"
        },
        "transforms": [
          {
            "code": "\tif value \u003d\u003d \u0027A\u0027:\n\t\treturn 1\n\tif value \u003d\u003d \u0027B\u0027:\n\t\treturn 2\n\tif value \u003d\u003d \u0027C\u0027:\n\t\treturn 3",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.shiftDetails": {
      "binding": {
        "config": {
          "parameters": {
            "shift": "{view.custom.shift}"
          },
          "queryPath": "OEE_Dashboard/shiftTimes",
          "returnFormat": "json"
        },
        "transforms": [
          {
            "code": "\tday \u003d system.date.format(self.custom.date, \"yyyy-MM-dd\")\n\tstartDateTime \u003d str(day + \" \"  +value[0][\"StartTime\"])\n\tendDateTime \u003d str(day + \" \" + value[0][\"EndTime\"])\n\treturn {\"start\": system.date.parse(startDateTime, \"yyyy-MM-dd HH:mm:ss\"), \n\t\t\t\"end\": system.date.parse(endDateTime, \"yyyy-MM-dd HH:mm:ss\")} if self.custom.shift !\u003d 3 else {\"end\": system.date.parse(endDateTime, \"yyyy-MM-dd HH:mm:ss\"), \"start\": system.date.addDays(system.date.parse(startDateTime, \"yyyy-MM-dd HH:mm:ss\"), -1)}",
            "type": "script"
          }
        ],
        "type": "query"
      },
      "persistent": true
    },
    "custom.users": {
      "persistent": true
    }
  },
