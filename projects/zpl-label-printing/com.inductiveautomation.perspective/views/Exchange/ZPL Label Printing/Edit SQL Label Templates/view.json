            }
          }
        },
        "meta": {
          "name": "BtnPreview"
        },
        "position": {
          "height": 45,
          "width": 135,
          "x": 155,
          "y": 55
        },
        "props": {
          "source": "",
          "style": {
            "classes": "Components/brownButtons"
          },
          "text": "Preview Label"
        },
        "type": "ia.input.button"
      },
      {
        "custom": {
          "fileContents": ""
        },
        "events": {
          "component": {
            "onFileReceived": {
              "config": {
                "script": "\t# when file is uploaded to component, get the string inside\n\tself.custom[\"fileContents\"] \u003d event.file.getString()\n\tlabelRawZPL \u003d event.file.getString()\n\t\n\t# .prn files printed from Zebra Designer 3 will have a preamble (prefix) and a postamble (suffix)\n\t# need to remove them and add our own preamble and postamble \n\t# (customized to work with printing printer time and offsetting the whole label in the xy directions)\n\t\n\t# get everything after the first ^XZ (end) command and before the ^PQ (number of copies) command in the ZPL text\n\t# this ignition project will later replace the ^LT0 and ^LS0 commands with offset_x_mm and offset_y_mm for the whole label\n\t# the command ^SL0,1 is paired with the ^FC command to always print the printer time\n\t# , even if it takes a long time to print all copies of the same label sent by Ignition\n\tlabelBody \u003d labelRawZPL.split(\u0027^XZ\u0027)[1].split(\u0027^PQ\u0027)[0] \n\tlabelZPL \u003d \u0027^XA^EG^XZ^XA^MCY^CI28^CF0^XZ^XA^SL0,1^LT0^LS0\u0027 + labelBody + \u0027^PQ1^LRN^XZ^XA^MCY^PON^LH0,0^XZ\u0027\n\t\n\tlabelInfo \u003d {}\n\tlabelInfo[\u0027labelZPL\u0027] \u003d labelZPL\n\tsystem.perspective.sendMessage(\u0027exchange.zplLabelPrinting.getLabelaryImage\u0027, scope\u003d\u0027page\u0027, payload\u003dlabelInfo)\n\t\n\t\n\t"
              },
              "scope": "G",
              "type": "script"
            },
            "onUploadsCleared": {
              "config": {
                "script": "\tself.custom[\"fileContents\"] \u003d \u0027\u0027"
              },
              "scope": "G",
              "type": "script"
            }
          },
          "system": {
            "onStartup": {
              "config": {
                "script": "\tself.custom[\"fileContents\"] \u003d \u0027\u0027"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "FileUpload"
        },
        "position": {
          "height": 90,
          "width": 280,
          "x": 10,
          "y": 110
