      {
        "meta": {
          "name": "LblStep4"
        },
        "position": {
          "height": 45,
          "width": 135,
          "x": 155,
          "y": 145
        },
        "props": {
          "text": "Add or Delete Users",
          "textStyle": {
            "textAlign": "center",
            "textDecoration": "underline"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "TextNewUser"
        },
        "position": {
          "height": 45,
          "width": 135,
          "x": 155,
          "y": 195
        },
        "type": "ia.input.text-field"
      },
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\t# get label data\n\tlabelName \u003d self.getSibling(\"DropTemplatesMirrored\").props.value\n\tuserName \u003d self.getSibling(\"TextNewUser\").props.text\n\t\n\t# get id from label templates table\n\tgetID \u003d \"\"\"\n\t\tselect id \n\t\tfrom ex_zpl_label_printing.ex_zlp_label_templates \n\t\twhere label_name \u003d ?\n\t\"\"\"\n\tlabelID_DS \u003d system.db.runPrepQuery(getID, [labelName], \u0027ex_zpl_label_printing\u0027)\n\tforeignKeyID \u003d labelID_DS.getValueAt(0, \u0027id\u0027)\n\t\n\t# now insert the record into the label users database table\n\taddUser \u003d \"\"\"\n\t\tinsert into ex_zpl_label_printing.ex_zlp_label_users \n\t\t(ex_zlp_label_templates_id, user_name) \n\t\tvalues (?, ?)\n\t\"\"\"\n\tr \u003d system.db.runPrepUpdate(addUser, [foreignKeyID, userName], \u0027ex_zpl_label_printing\u0027)\n\t\n\tsystem.perspective.sendMessage(\u0027exchange.zplLabelPrinting.refreshLabelUsers\u0027, scope\u003d\u0027page\u0027)\n\texchange.zplLabelPrinting.popup.displayMessage(\u0027Assigned User to Label\u0027, \u0027Successfully added user to label template!\u0027)\n\t\n\t\n\t"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "BtnUserAdd"
        },
        "position": {
          "height": 45,
          "width": 135,
          "x": 155,
          "y": 250
        },
        "propConfig": {
          "props.enabled": {
            "binding": {
              "config": {
                "expression": "if(\r\n\tlen({../TextNewUser.props.text}) \u003e 0\r\n\t, true \r\n\t, false \r\n)"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "classes": "Components/brownButtons"
          },
          "text": "Add User"
        },
        "type": "ia.input.button"
      },
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\t# confirm deletion\n\tmessage \u003d \u0027Please confirm you wish to delete this user.\u0027\n\texchange.zplLabelPrinting.popup.displayConfirmation(message)\n\t\n\t\n\t"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "BtnUserDelete"
        },
        "position": {
          "height": 45,
          "width": 135,
          "x": 155,
          "y": 345
        },
        "propConfig": {
          "props.enabled": {
            "binding": {
              "config": {
                "expression": "if(\r\n\t{../TableUsers.props.selection.selectedRow} !\u003d null \r\n\t, true \r\n\t, false \r\n)"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "classes": "Components/brownButtons"
          },
          "text": "Delete User"
        },
        "scripts": {
          "customMethods": [],
          "extensionFunctions": null,
          "messageHandlers": [
            {
              "messageType": "exchange.zplLabelPrinting.confirmPopup",
              "pageScope": true,
              "script": "\t# get selected label name and user name\n\tlabelName \u003d self.getSibling(\"DropTemplatesMirrored\").props.value\n\tuserName \u003d self.getSibling(\"TableUsers\").props.selection.data[0].user_name\n\t\n\t# get id from label templates table\n\tgetID \u003d \"\"\"\n\t\tselect id \n\t\tfrom ex_zpl_label_printing.ex_zlp_label_templates \n\t\twhere label_name \u003d ?\n\t\"\"\"\n\tlabelID_DS \u003d system.db.runPrepQuery(getID, [labelName], \u0027ex_zpl_label_printing\u0027)\n\tforeignKeyID \u003d labelID_DS.getValueAt(0, \u0027id\u0027)\n\t\n\t# delete selected record from sql for the selected label name and user name\n\tdeleteUser \u003d \"\"\"\n\t\tdelete from ex_zpl_label_printing.ex_zlp_label_users \n\t\twhere ex_zlp_label_templates_id \u003d ? and user_name \u003d ? \n\t\"\"\"\n\tr \u003d system.db.runPrepUpdate(deleteUser, [foreignKeyID, userName], \u0027ex_zpl_label_printing\u0027)\n\t\n\tsystem.perspective.sendMessage(\u0027exchange.zplLabelPrinting.refreshLabelUsers\u0027, scope\u003d\u0027page\u0027)\n\texchange.zplLabelPrinting.popup.displayMessage(\u0027Removed User from Label\u0027, \u0027Successfully removed user from label template!\u0027)\n\t\n\t\n\t",
              "sessionScope": false,
              "viewScope": true
            }
          ]
        },
        "type": "ia.input.button"
      }
    ],
    "meta": {
      "name": "root"
    },
