                  "messageType": "ColumnUpdate",
                  "pageScope": true,
                  "script": "\t# implement your handler here\n\trowIndex \u003d payload[\u0027rowIndex\u0027]\n\tcolumn \u003d payload[\u0027column\u0027]\n\tnewValue \u003d payload[\u0027newValue\u0027]\n\trowData \u003d payload[\u0027rowData\u0027] \n#\tself.view.custom.rowData \u003d rowIndex \u003d payload[\u0027rowIndex\u0027]\n\trows \u003d list(self.view.custom.RowIndexes)\n#\tself.view.custom.rowData \u003d  rowData.id\n\tif self.props.data[rowIndex][column] !\u003d newValue:\n\t\tval \u003d {\"rowIndex\":rowIndex, \"row\":rowData.id, \"value\": newValue}\n\t\trows.append(val)\n\tif len(rows)\u003e0:\n\t\tfor item in rows:\n\t\t\tif self.props.data[item[\"rowIndex\"]][column] \u003d\u003d newValue and item[\"row\"]\u003d\u003drowData.id:\n\t\t\t\trows.remove(item)\n\tself.view.custom.RowIndexes \u003d rows",
                  "sessionScope": false,
                  "viewScope": false
                },
