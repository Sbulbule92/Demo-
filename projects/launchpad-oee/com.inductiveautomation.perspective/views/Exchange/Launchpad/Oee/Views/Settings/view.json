                      "text": "Base Tag Folder"
                    },
                    "type": "ia.display.label"
                  },
                  {
                    "meta": {
                      "name": "LineTagFolder"
                    },
                    "position": {
                      "grow": 1
                    },
                    "propConfig": {
                      "props.text": {
                        "binding": {
                          "config": {
                            "bidirectional": true,
                            "path": "session.custom.exchange.launchpad.oee.lineTagFolder"
                          },
                          "type": "property"
                        }
                      }
                    },
                    "props": {
                      "enabled": false,
                      "style": {
                        "classes": "exchange/launchpad/oee/control/text-entry-dark",
                        "marginBottom": 5,
                        "marginTop": 5
                      }
                    },
                    "type": "ia.input.text-field"
                  }
                ],
                "meta": {
                  "name": "Settings"
                },
                "position": {
                  "basis": "50px",
                  "grow": 1,
                  "shrink": 0
                },
                "props": {
                  "style": {
                    "overflow": "visible"
                  },
                  "wrap": "wrap"
                },
                "type": "ia.container.flex"
              },
              {
                "meta": {
                  "name": "Info"
                },
                "position": {
                  "grow": 1,
                  "shrink": 0
                },
                "props": {
                  "alignVertical": "top",
                  "style": {
                    "classes": "exchange/launchpad/oee/text/label"
                  },
                  "text": "All line UDT instances should all be in one folder.  Provide the path to the folder in order to get the list of all line names.",
                  "textStyle": {
                    "marginLeft": "20px",
                    "textAlign": "start"
                  }
                },
                "type": "ia.display.label"
              }
            ],
            "meta": {
              "name": "TagFolder"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "direction": "column",
              "style": {
                "overflow": "visible"
              },
              "wrap": "wrap"
            },
            "type": "ia.container.flex"
          },
          {
            "children": [
              {
                "children": [
                  {
                    "meta": {
                      "name": "Label"
                    },
                    "position": {
                      "basis": "100px",
                      "shrink": 0
                    },
                    "props": {
                      "style": {
                        "classes": "exchange/launchpad/oee/text/label"
                      },
                      "text": "OEE Target"
                    },
                    "type": "ia.display.label"
                  },
                  {
                    "meta": {
                      "name": "Slider"
                    },
                    "position": {
                      "basis": "300px"
                    },
                    "propConfig": {
                      "props.value": {
                        "binding": {
                          "config": {
                            "bidirectional": true,
                            "path": "session.custom.exchange.launchpad.oee.target"
                          },
                          "type": "property"
                        }
                      }
                    },
                    "props": {
                      "labels": {
                        "interval": 0.05
                      },
                      "max": 1,
                      "step": 0.01
                    },
                    "type": "ia.input.slider"
                  },
                  {
                    "meta": {
                      "name": "LedDisplay"
                    },
                    "position": {
                      "basis": "50px",
                      "shrink": 0
                    },
                    "propConfig": {
                      "props.value": {
                        "binding": {
                          "config": {
                            "path": "session.custom.exchange.launchpad.oee.target"
                          },
                          "transforms": [
                            {
                              "code": "\treturn str(value*100).split(\".\")[0] + \"%\"",
                              "type": "script"
                            }
                          ],
                          "type": "property"
                        }
                      }
                    },
                    "props": {
                      "backgroundColor": "var(--oee-card)",
                      "diodeOnColor": "var(--oee-good)"
                    },
                    "type": "ia.display.led-display"
                  }
                ],
                "meta": {
                  "name": "OeeTarget"
                },
                "position": {
                  "basis": "70px"
                },
                "type": "ia.container.flex"
              },
              {
                "meta": {
                  "name": "Info"
                },
                "props": {
                  "markdown": {
                    "escapeHtml": false
                  },
                  "source": "Adjust this value for the \"good\" OEE value you are targeting.\n\nAll displays of the OEE value that change color will show as red if below this value, and blue if above this value.\n\nThis is not stored historically, it is only used for the live display of colors.",
                  "style": {
                    "classes": "exchange/launchpad/oee/text/label",
                    "marginLeft": 20,
                    "textAlign": "start"
                  }
                },
                "type": "ia.display.markdown"
              }
            ],
            "meta": {
              "name": "OeeTargetFlex"
            },
            "position": {
              "grow": 1,
              "shrink": 0
            },
            "props": {
              "direction": "column"
            },
            "type": "ia.container.flex"
          }
        ],
        "meta": {
          "name": "Global"
        },
        "position": {
          "grow": 1,
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "{parent.custom.showManageRates}\u003dFalse"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "direction": "column",
          "style": {
            "classes": "exchange/launchpad/oee/card"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "custom": {
      "showManageRates": false
    },
    "events": {
      "system": {
        "onStartup": {
          "config": {
            "script": "\tsystem.perspective.sendMessage(\"navigation\", \"Settings\")\t"
          },
          "scope": "G",
          "type": "script"
        }
      }
    },
    "meta": {
      "name": "root"
    },
    "propConfig": {
      "custom.database": {
        "binding": {
          "config": {
            "expression": "1"
          },
          "transforms": [
            {
              "code": "\treturn exchange.launchpad.oee.DATABASE_NAME",
              "type": "script"
            }
          ],
          "type": "expr"
        }
      }
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "exchange/launchpad/oee/root"
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "exchange-launchpad-oee-refresh-rates",
          "pageScope": true,
          "script": "\tself.custom.showManageRates \u003d False\n\t",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
}