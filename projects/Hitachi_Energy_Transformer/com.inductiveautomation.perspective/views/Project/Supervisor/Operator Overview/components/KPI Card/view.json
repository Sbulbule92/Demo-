{
  "custom": {},
  "params": {
    "label": "value",
    "value": "value"
  },
  "propConfig": {
    "params.label": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 82,
      "width": 105
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Title"
        },
        "position": {
          "basis": "22px",
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.label"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "borderBottomColor": "--neutral-30",
            "borderBottomStyle": "solid",
            "borderBottomWidth": "2px",
            "marginLeft": "10px",
            "marginRight": "10px"
          },
          "textStyle": {
            "color": "--neutral-70",
            "fontSize": "18px"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Value"
        },
        "position": {
          "basis": "32px",
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "{view.params.value} + \"%\""
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "textStyle": {
            "fontSize": "22px",
            "fontWeight": "500"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "propConfig": {
      "props.style.borderColor": {
        "binding": {
          "config": {
            "path": "view.params.value"
          },
          "transforms": [
            {
              "fallback": "--neutral-60",
              "inputType": "range",
              "mappings": [
                {
                  "input": {
                    "max": 40,
                    "min": 0
                  },
                  "output": "--error"
                },
                {
                  "input": {
                    "max": 70,
                    "min": 41
                  },
                  "output": "--warning"
                },
                {
                  "input": {
                    "max": 100,
                    "min": 71
                  },
                  "output": "--success"
                }
              ],
              "outputType": "scalar",
              "type": "map"
            }
          ],
          "type": "property"
        }
      }
    },
    "props": {
      "direction": "column",
      "style": {
        "backgroundColor": "--neutral-20",
        "borderBottomLeftRadius": "10px",
        "borderBottomRightRadius": "10px",
        "borderStyle": "none",
        "borderTopLeftRadius": "10px",
        "borderTopRightRadius": "10px",
        "borderWidth": "1px",
        "fontFamily": "Verdana",
        "fontSize": "18px",
        "fontWeight": "500",
        "margin": "5px",
        "textAlign": "center"
      }
    },
    "type": "ia.container.flex"
  }
}