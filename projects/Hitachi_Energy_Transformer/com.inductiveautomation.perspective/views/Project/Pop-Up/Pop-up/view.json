          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tserial_number \u003d system.tag.readBlocking(\u0027[default]Project/jobid\u0027)[0].value\n\tif str(self.view.params.action).lower() \u003d\u003d \"confirm\" and self.view.params.label\u003d\u003d \"Supervisor Assistance\":\n\t\tsystem.perspective.closePopup(\u0027PopUp\u0027)\n\t\tsystem.tag.writeBlocking(\u0027[default]Project/jobid\u0027, \"Not Started yet\")\n\t\tsystem.tag.writeBlocking(\u0027[default]Project/program\u0027, \"Not Started yet\")\n\t\tsystem.tag.writeBlocking(\u0027[default]Project/Cancelled\u0027, True)\n\t\tparams \u003d {\"action\": \"success\", \"primaryText\": \"Supervisor notified successfully!\", \"secondaryText\":\" \"}\n\t\tsystem.perspective.openPopup(\"PopUp\", view \u003d \"Project/Pop-Up/Pop-up\", \n\t\t\t\t\t\t\t\t\t\tparams \u003d params, \n\t\t\t\t\t\t\t\t\t\tshowCloseIcon \u003d False,\n\t\t\t\t\t\t\t\t\t\tdraggable \u003d False, \n\t\t\t\t\t\t\t\t\t\tmodal \u003d True)\n\t\ttagpath\u003d[\u0027[default]WOCL_1/Supervisor_Assistance_requested\u0027]\n\t\tsystem.tag.writeBlocking(tagpath,[1])\n\t\t\n\t\t\n\t\t# \u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n\t\t# \tOn work in progress if user confirm for cancel the jo then this script will execute.\n\t\t# \u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n\t\tif self.page.props.path \u003d\u003d \u0027/wip\u0027:\n\t\t\t#\tparam \u003d {\"serial_number\": serial_number}\n\t\t\t#\tval \u003d system.db.execQuery(\u0027OEE_Dashboard/Cancelled\u0027, parameters\u003dparam)\n\t\t\tquery \u003d \"\"\"\n\t\t\tUPDATE TankPrograms\n\t\t\tSET work_status \u003d 0\n\t\t\tWHERE serial_number\u003d ?\n\t\t\t\"\"\"\n\t\t\tsystem.perspective.print(serial_number)\n\t\t\tresult \u003d system.db.runPrepUpdate(\n\t\t\t    query,\n\t\t\t    [serial_number],\n\t\t\t    \"Historian\"\n\t\t\t)\n\t\t\tif result:\n\t\t\t\tsystem.tag.writeBlocking(\u0027[default]Project/Simulation/Abort\u0027, True)\n\t\t#\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003dEND\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\u003d\n\telif self.view.params.label \u003d\u003d\"Lunch Break\": \n\t\tshift\u003dsystem.tag.readBlocking(\"[default]Current_Shift/shift_ID\")[0].value\n\t\tparameters \u003d { \"ReasonID\":30, \"DowntimeStatus\":True,\"username\":self.session.props.auth.user.userName,\"StartTime\":system.date.now(),\"ShiftID\":shift} \n\t\tsystem.db.runNamedQuery(\"downtime/insert\", parameters)\n\t\tsystem.perspective.logout()\n\telif self.view.params.label \u003d\u003d\"Break\":\n\t\tshift\u003dsystem.tag.readBlocking(\"[default]Current_Shift/shift_ID\")[0].value\n\t\tparameters \u003d { \"ReasonID\":29, \"DowntimeStatus\":True,\"username\":self.session.props.auth.user.userName,\"StartTime\":system.date.now(),\"ShiftID\":shift} \n\t\t\t# Run the Named Query\n\t\tsystem.db.runNamedQuery(\"downtime/insert\", parameters)\n\t\tsystem.perspective.logout()\n\telif self.view.params.label \u003d\u003d \"manual downtime\" and str(self.view.params.action).lower() \u003d\u003d \"success\" :\n\t\tsystem.perspective.closePopup(\u0027PopUp\u0027)\n\t\tsystem.perspective.navigate(page\u003d\"/home\")\n\telse:\n\t\tsystem.perspective.closePopup(\u0027PopUp\u0027)\n\t\t#pass"
                  },
                  "scope": "G",
                  "type": "script"
                }
