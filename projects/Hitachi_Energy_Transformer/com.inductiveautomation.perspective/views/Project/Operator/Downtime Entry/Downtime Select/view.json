{
  "custom": {},
  "params": {
    "ReasonID": "value",
    "ReasonName": "value",
    "icon": "published_with_changes",
    "label": "value"
  },
  "propConfig": {
    "params.ReasonID": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.ReasonName": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.icon": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.label": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 85.38095092773438,
      "width": 349
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Icon"
        },
        "position": {
          "basis": "50px"
        },
        "propConfig": {
          "props.path": {
            "binding": {
              "config": {
                "expression": "\"material/\" + {view.params.icon}"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "marginLeft": "5px"
          }
        },
        "type": "ia.display.icon"
      },
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.label"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "fontFamily": "verdana",
            "fontSize": "20px",
            "fontWeight": "500",
            "paddingLeft": "10px"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "events": {
      "dom": {
        "onClick": {
          "config": {
            "script": "\tselectedReasonID\u003dself.view.params.ReasonID\n\tselectedReasonName\u003dself.view.params.label\n\tparams\u003d{\"ReasonID\":selectedReasonID,\"ReasonName\":selectedReasonName}\n#\tsystem.perspective.navigate(page\u003d\"/op_downtime_confirm\", params\u003dparams)\n\n\t#params\u003d{\"jobid\":serial_number,\"program\":program_name}\n#\tif selectedReasonID !\u003d36 : \n\tsystem.perspective.navigate(view\u003d\u0027Project/Operator/Operator/downtime_confirm\u0027, params\u003dparams)\n#\telse:\n#\t\tsystem.perspective.navigate(view\u003d\u0027Operator/other_downtime_confirm\u0027, params\u003dparams)\n#\t#system.perspective.navigate(page\u003d\"/op_downtime_confirm\")"
          },
          "scope": "G",
          "type": "script"
        }
      }
    },
    "meta": {
      "name": "root"
    },
    "props": {
      "style": {
        "backgroundColor": "--neutral-30",
        "borderBottomLeftRadius": "10px",
        "borderBottomRightRadius": "10px",
        "borderTopLeftRadius": "10px",
        "borderTopRightRadius": "10px",
        "classes": "downtime",
        "color": "--neutral-80",
        "cursor": "pointer"
      }
    },
    "type": "ia.container.flex"
  }
}