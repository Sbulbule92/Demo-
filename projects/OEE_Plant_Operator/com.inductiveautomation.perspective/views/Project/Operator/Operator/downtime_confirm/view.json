                "type": "ia.display.label"
              },
              {
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "\t#categorydowntime \u003dself.parent.parent.getChild(\"down_cat_flex\").getChild(\"Dropdown\").props.value\n\tmachineID\u003dself.session.custom.machineInfo.ID\n\tlineID\u003dself.session.custom.machineInfo.lineID\n\treasondowntime \u003d self.view.params.ReasonID\n\tinprogressdowntime\u003dself.parent.parent.getChild(\"downtime_inprogress_flex\").getChild(\"Checkbox\").props.selected\n\tstarttime\u003dself.parent.parent.getChild(\"Start_time_flex\").getChild(\"DateTimeInput\").props.value\n\tEndTime\u003dself.parent.parent.getChild(\"end_time_flex\").getChild(\"DateTimeInput\").props.value\n\tshift\u003dsystem.tag.readBlocking(\"[default]Current_Shift/shift_ID\")[0].value\n\tdescdowntime\u003dself.parent.parent.getChild(\"downtime_desc_flex\").getChild(\"TextArea\").props.text\n\tbasePath\u003dself.session.custom.machineInfo.basePath\n\tuser\u003dself.session.props.auth.user.userName\n\terrorcode\u003d\u0027\u0027\n\tdtstatus\u003d3\n#\tif categorydowntime \u003c 1 :\n#\t\terrorcode\u003d \"Please select a Downtime category\"\n\tif reasondowntime \u003c 1 :\n\t\terrorcode\u003d \"Please select a Downtime reason\"\n\telif starttime is None :\n\t\terrorcode\u003d \"Please select start time\"\n\telif inprogressdowntime \u003d\u003d False and EndTime is None:\n\t\terrorcode\u003d \"Please select end time\"\n\telif len(descdowntime) \u003c\u003d 4 and  self.view.params.ReasonID\u003d\u003d15:\n\t\terrorcode\u003d \"Please provide downtime description \"\n\telif inprogressdowntime \u003d\u003d False and EndTime \u003e system.date.now():\n\t\terrorcode\u003d \"End date should be less than current time\"\n\telif starttime \u003e system.date.now():\n\t\terrorcode\u003d \"Start date should be less than current time\"\t\t\n\t\t\n\telse:\n#\t\tdtactivestatus\u003dsystem.tag.readBlocking([self.session.custom.machineInfo.basePath+\u0027/Downtime/Active\u0027,self.session.custom.machineInfo.basePath+\u0027/Downtime/StartTime\u0027])\n\t\tdtactivestatus\u003dsystem.tag.readBlocking([self.session.custom.machineInfo.basePath+\u0027/Downtime/Ongoingbreakdown\u0027,self.session.custom.machineInfo.basePath+\u0027/Downtime/StartTime\u0027])\n\t\tdtactive\u003ddtactivestatus[0].value\n\t\tdtstarttime\u003ddtactivestatus[1].value\n\t\tif inprogressdowntime :\n\t\t\tif dtactive\u003d\u003d True :\n\t\t\t\terrorcode\u003d\"Downtime detection in progress. Please wait before manual entry is allowed\"\n\t\t\telse :\n\t\t\t\tparameters \u003d { \"StartTime\":starttime,\"MachineID\":machineID,\"EndTime\":system.date.now()}\n\t\t\t\tcheckdowntimexist\u003dsystem.db.runNamedQuery(\"downtime/Checkifdowntimeexists\", parameters)\n\t\t\t\tif checkdowntimexist.getValueAt(0,\"IsOverlap\")\u003d\u003d0:\n\t\t\t\t\tparameters \u003d { \"ReasonID\":reasondowntime, \"DowntimeStatus\":not inprogressdowntime,\"username\":user,\"StartTime\":starttime,\"ShiftID\":shift,\"DowntimeSource\":0,\"Remarks\":descdowntime,\"categoryID\":1,\"MachineID\":machineID,\"LineID\":lineID}\n\t\t\t\t\treturndata\u003dsystem.db.runNamedQuery(\"downtime/InsertDowntimeEntry\", parameters)\n\t\t\t\t\tif returndata.getRowCount() \u003d\u003d 0:\n\t\t\t\t\t\tdtstatus\u003d2\n\t\t\t\t\telse:\n\t\t\t\t\t\tdtstatus\u003d1\n\t\t\t\t\t\tsystem.tag.writeBlocking([basePath+\"/Downtime/Ongoingbreakdown\",basePath+\"/Downtime/Manual_entry_Active\"],[True,True])\n\t\t\t\telse:\n\t\t\t\t\tdtstatus\u003d0\n\t\telse:\n\t\t\tif dtactive\u003d\u003d True and starttime \u003c\u003d dtstarttime \u003c\u003d EndTime:\n\t\t\t\terrorcode\u003d\"Downtime detection in progress. Please wait before manual entry is allowed\"\n\t\t\telse :\t\n\t\t\t\tparameters \u003d { \"StartTime\":starttime,\"MachineID\":machineID,\"EndTime\":EndTime}\n\t\t\t\tcheckdowntimexist\u003dsystem.db.runNamedQuery(\"downtime/Checkifdowntimeexists\", parameters)\n\t\t\t\tif checkdowntimexist.getValueAt(0,\"IsOverlap\")\u003d\u003d0:\n\t\t\t\t\tparameters \u003d {\"ReasonID\":reasondowntime,  \"DowntimeStatus\":not inprogressdowntime,\"username\":user,\"StartTime\":starttime,\"EndTime\":EndTime,\"shiftID\":shift,\"DowntimeSource\":0,\"Remarks\":descdowntime,\"machineID\":machineID,\"lineID\":lineID} \n\t\t\t\t\treturndata\u003dsystem.db.runNamedQuery(\"downtime/InsertManualDowntime\", parameters)\n\t\t\t\t\tif returndata.getRowCount() \u003d\u003d 0:\n\t\t\t\t\t\tdtstatus\u003d2\n\t\t\t\t\telse:\n\t\t\t\t\t\tdtstatus\u003d1\n\t\t\t\telse:\n\t\t\t\t\tdtstatus\u003d0\n\t\tif dtstatus \u003d\u003d 1:\n\t\t\tparams \u003d {\"action\": \"success\", \"primaryText\": \"Downtime logged successfully!\", \"secondaryText\":\"\",\"label\":\"manual downtime\"}\n\t\t\tsystem.perspective.openPopup(\"PopUp\", view \u003d \"Project/Pop-Up/Pop-up\", \n\t\t\t\t\t\t\t\t\t\t\tparams \u003d params, \n\t\t\t\t\t\t\t\t\t\t\tshowCloseIcon \u003d False,\n\t\t\t\t\t\t\t\t\t\t\tdraggable \u003d False, \n\t\t\t\t\t\t\t\t\t\t\tmodal \u003d True)\n\t\telif dtstatus \u003d\u003d 0:\n\t\t\tparams \u003d {\"action\": \"error\", \"primaryText\": \"Downtime Already exists!\", \"secondaryText\":\"\",\"label\":\"manual downtime\"}\n\t\t\tsystem.perspective.openPopup(\"PopUp\", view \u003d \"Project/Pop-Up/Pop-up\", \n\t\t\t\t\t\t\t\t\t\t\t\t\t\tparams \u003d params, \n\t\t\t\t\t\t\t\t\t\t\t\t\t\tshowCloseIcon \u003d False,\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tdraggable \u003d False, \n\t\t\t\t\t\t\t\t\t\t\t\t\t\tmodal \u003d True)\n\t\telif  dtstatus \u003d\u003d 2:\n\t\t\tparams \u003d {\"action\": \"error\", \"primaryText\": \"Something went Wrong!\", \"secondaryText\":\"\",\"label\":\"manual downtime\"}\n\t\t\tsystem.perspective.openPopup(\"PopUp\", view \u003d \"Project/Pop-Up/Pop-up\", \n\t\t\t\t\t\t\t\t\t\t\t\t\t\tparams \u003d params, \n\t\t\t\t\t\t\t\t\t\t\t\t\t\tshowCloseIcon \u003d False,\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tdraggable \u003d False, \n\t\t\t\t\t\t\t\t\t\t\t\t\t\tmodal \u003d True)\n\tself.getSibling(\"Label\").props.text\u003d errorcode\n\t#system.perspective.navigate(url\u003d\"http://localhost:8088/data/perspective/client/Shiva_Hitachi/opr_job_board\")"
                      },
                      "scope": "G",
                      "type": "script"
                    }
