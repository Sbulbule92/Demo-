            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\tif self.custom.currentTheme in [\u0027light-cool\u0027, \u0027light\u0027, \u0027light-warm\u0027]:\n\t\tself.custom.currentTheme \u003d \u0027dark-cool\u0027\n\telse:\n\t\tself.custom.currentTheme \u003d \u0027light-cool\u0027\n\t\t\n##\tlist1 \u003d [\u0027light\u0027, \u0027light-cool\u0027, \u0027light-warm\u0027, \u0027dark\u0027, \u0027dark-cool\u0027, \u0027dark-warm\u0027]\n#\tsystem.perspective.print(\"started\")\n#\tlist1 \u003d [\u0027light-cool\u0027, \u0027dark-cool\u0027]\n#\tcurrent_Value \u003d list1.index(str(self.view.custom.currentTheme))\n#\tsystem.perspective.print(current_Value)\n#\tif current_Value \u003c (len(list1)-1):\n#\t\tcurrent_Value \u003d current_Value + 1\n#\telse:\n#\t\tcurrent_Value \u003d 0\n#\tself.view.custom.currentTheme \u003d list1[current_Value]\n#\tsystem.perspective.print(self.view.custom.currentTheme)\n##\tself.getSibling(\"Label\").props.text \u003d list1[current_Value]\n\tif self.custom.currentTheme in [\u0027light-cool\u0027, \u0027light\u0027, \u0027light-warm\u0027]:\n\t\tself.props.path \u003d \u0027material/bedtime\u0027\n\telse:\n\t\tself.props.path \u003d \u0027material/wb_sunny\u0027\n#\tcurrent_theme \u003d self.session.props.theme\n#\tif current_theme \u003d\u003d \u0027light-cool\u0027:\n#\t\tself.session.props.theme \u003d \u0027dark-cool\u0027\n#\t\tself.props.path \u003d \u0027material/wb_sunny\u0027\n#\telse:\n#\t\tself.session.props.theme \u003d \u0027light-cool\u0027\n#\t\tself.props.path \u003d \u0027material/bedtime\u0027"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
