    "OEE": "value",
    "Performance": "value",
    "Quality": "value"
  },
  "propConfig": {
    "params.Availability": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.OEE": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.Performance": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.Quality": {
      "paramDirection": "input",
      "persistent": true
    }
