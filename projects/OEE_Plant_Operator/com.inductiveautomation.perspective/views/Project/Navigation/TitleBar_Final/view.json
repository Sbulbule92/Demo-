    "system": {
      "onStartup": {
        "config": {
          "script": "\tif self.session.custom.activeDowntime:\n\t\tsystem.perspective.openPopup(id\u003d\u0027Popup\u0027,view\u003d\u0027Project/Operator/Operator/Active_downtime/downtime_confirm\u0027, showCloseIcon\u003dFalse, draggable \u003d False, modal\u003dTrue)"
