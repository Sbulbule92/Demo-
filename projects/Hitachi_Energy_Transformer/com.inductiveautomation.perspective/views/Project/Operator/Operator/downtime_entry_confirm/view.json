on, \"User\": user} \n\t\t\t# Run the Named Query\n\t\tsystem.db.runNamedQuery(\"downtime/updatereason_desc\", parameters)\n\t\tsystem.perspective.closePopup(id\u003d\"PopUp\")\n\t\tparams \u003d {    \"action\": \"success\",\n                \"primaryText\": \"Data Saved Successfully!\",\n                \"secondaryText\":\"Downtime data stored successfully\u0027!\"}\n\t\tsystem.perspective.openPopup(\"PopUp\", view \u003d \"Project/Pop-Up/Pop-up\", \n\t\t\t                    params \u003d params, \n\t\t\t                    showCloseIcon \u003d False,\n\t\t\t                    draggable \u003d False, \n\t\t\t                    modal \u003d True)\n\tself.getSibling(\"Label\").props.text\u003d errorcode\n\t\t\t\t\t\t"
