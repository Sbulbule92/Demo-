{
  "custom": {},
  "params": {
    "DurationMinutes": 19,
    "ReasonID": "value",
    "ReasonName": "Computer",
    "Remarks": "Test Change over",
    "logID": "value"
  },
  "propConfig": {
    "params.DurationMinutes": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.ReasonID": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.ReasonName": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.Remarks": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.logID": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 60
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Reason"
        },
        "position": {
          "basis": "150px"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.ReasonName"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "backgroundColor": "--neutral-20",
            "borderBottomLeftRadius": "10px",
            "borderBottomRightRadius": "10px",
            "borderStyle": "solid",
            "borderTopLeftRadius": "10px",
            "borderTopRightRadius": "10px",
            "borderWidth": "1px",
            "margin": "5px"
          },
          "textStyle": {
            "fontFamily": "Verdana",
            "fontSize": "20px",
            "textAlign": "center"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "comments"
        },
        "position": {
          "basis": "400px",
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.Remarks"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "backgroundColor": "--neutral-20",
            "borderBottomLeftRadius": "10px",
            "borderBottomRightRadius": "10px",
            "borderStyle": "solid",
            "borderTopLeftRadius": "10px",
            "borderTopRightRadius": "10px",
            "borderWidth": "1px",
            "margin": "5px"
          },
          "textStyle": {
            "fontFamily": "Verdana",
            "fontSize": "20px",
            "textAlign": "center"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "time_taken"
        },
        "position": {
          "basis": "150px"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "{view.params.DurationMinutes}+\" Min\""
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "backgroundColor": "--neutral-20",
            "borderBottomLeftRadius": "10px",
            "borderBottomRightRadius": "10px",
            "borderStyle": "solid",
            "borderTopLeftRadius": "10px",
            "borderTopRightRadius": "10px",
            "borderWidth": "1px",
            "margin": "5px"
          },
          "textStyle": {
            "fontFamily": "Verdana",
            "fontSize": "20px",
            "textAlign": "center"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "events": {
      "dom": {
        "onDoubleClick": {
          "config": {
            "script": "\tselectedreasonID\u003dself.view.params.ReasonID\n\tselectedlogID\u003dself.view.params.logID\n\tparams \u003d {\"ReasonID\":selectedreasonID,\"logID\":selectedlogID}\n\tsystem.perspective.openPopup(\"PopUp1\", view \u003d \"Project/Supervisor/downtime_confirm_popup\", \n\t\t\t\t\t\t\t\t\t\tparams \u003d params, \n\t\t\t\t\t\t\t\t\t\tshowCloseIcon \u003d False,\n\t\t\t\t\t\t\t\t\t\tdraggable \u003d False, \n\t\t\t\t\t\t\t\t\t\tmodal \u003d True)"
          },
          "scope": "G",
          "type": "script"
        }
      }
    },
    "meta": {
      "name": "root"
    },
    "type": "ia.container.flex"
  }
}