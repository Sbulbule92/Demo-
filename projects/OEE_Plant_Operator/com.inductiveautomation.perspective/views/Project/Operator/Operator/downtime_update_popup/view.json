  "params": {},
  "propConfig": {
    "custom.icons": {
      "persistent": true
    },
    "custom.pending_downtime": {
      "binding": {
        "config": {
          "parameters": {
            "MachineID": "{session.custom.machineInfo.ID}"
          },
          "queryPath": "downtime/pending_entry",
          "returnFormat": "json"
        },
        "type": "query"
      },
      "persistent": true
    },
    "custom.reasons": {
      "binding": {
        "config": {
          "struct": {
            "pendindLogID": "{view.custom.pending_downtime[0].LogID}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\treasons\u003dsystem.db.runNamedQuery(\"utility/dropdown/GetDowntimeReasonCodes\")\n\ticons \u003d self.custom.icons\n\tdata \u003d []\n\tfor i in range(0, len(reasons)):\n\t\tval \u003d {\"label\": reasons[i][\u0027label\u0027], \"icon\":icons[i],\"ReasonID\":reasons[i][\u0027value\u0027],\"LogID\":value[\"pendindLogID\"]}\n\t\tdata.append(val)\n\treturn data\n\t#return value",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 700
    }
  },
  "root": {
