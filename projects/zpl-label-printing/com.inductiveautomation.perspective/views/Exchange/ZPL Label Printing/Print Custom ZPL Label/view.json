          "customMethods": [],
          "extensionFunctions": null,
          "messageHandlers": [
            {
              "messageType": "exchange.zplLabelPrinting.getLabelaryImage",
              "pageScope": true,
              "script": "\t# first reset image and zpl text\n\tself.props.source \u003d \u0027\u0027\n\tself.custom.zpl \u003d \u0027\u0027\n\tself.props.altText \u003d \u0027Waiting for Labelary or Next Action...\u0027\n\t\n\t# Get the labelZPL string from the payload and get selected rotation from radio button\n\tlabelZPL \u003d payload[\u0027labelZPL\u0027]\n\tlabelRotation \u003d self.getSibling(\"RadioRotation\").props.value\n\t\n\t# use function to call Labelary API and retrieve image. If not available, fall back to local scripts.\n\ttry:\n\t\timageSource \u003d exchange.zplLabelPrinting.label.getLabelaryImage(labelZPL, int(labelRotation))\n\t\tif imageSource \u003d\u003d \u0027\u0027: # error returned from Labelary\n\t\t\timageSource \u003d exchange.zplLabelPrinting.label.getLocalImage(labelZPL, int(labelRotation))\n\texcept:\n\t\timageSource \u003d exchange.zplLabelPrinting.label.getLocalImage(labelZPL, int(labelRotation))\n\t\n\tself.props.source \u003d imageSource\n\tself.custom.zpl \u003d labelZPL\n\t\n\t\n\t",
              "sessionScope": false,
              "viewScope": false
            }
          ]
        },
