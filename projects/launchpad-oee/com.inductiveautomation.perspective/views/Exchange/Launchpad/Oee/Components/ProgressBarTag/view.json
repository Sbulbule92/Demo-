{
  "custom": {
    "background": null,
    "engHigh": null,
    "engLow": null,
    "format": null,
    "label": "Line 1",
    "progress": null,
    "units": null,
    "value": null
  },
  "params": {
    "path": "[default]Exchange/Launchpad/Oee/Demo/Line1/ShiftOee/Shift_O",
    "title": "Line 1"
  },
  "propConfig": {
    "custom.background": {
      "binding": {
        "config": {
          "path": "view.custom.progress"
        },
        "transforms": [
          {
            "code": "\treturn \u0027linear-gradient(to right,var(--oee-gray-a) %s%%, var(--oee-gray-q) 0%%)\u0027 % (value*100.0)",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.engHigh": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "path": "{view.params.path}"
          },
          "tagPath": "{path}.EngHigh"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "custom.engLow": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "path": "{view.params.path}"
          },
          "tagPath": "{path}.EngLow"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "custom.format": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "path": "{view.params.path}"
          },
          "tagPath": "{path}.FormatString"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "custom.label": {
      "binding": {
        "config": {
          "path": "view.params.title"
        },
        "transforms": [
          {
            "code": "\tif value \u003d\u003d \u0027\u0027:\n\t\treturn self.params.path.split(\u0027/\u0027)[-1]\n\telse:\n\t\treturn value",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.progress": {
      "binding": {
        "config": {
          "struct": {
            "engHigh": "{view.custom.engHigh}",
            "engLow": "{view.custom.engLow}",
            "value": "{view.custom.value}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\tfullRange \u003d value.engHigh - value.engLow\n\tvalueRange \u003d value.value - value.engLow\n\treturn 1.0 * valueRange / fullRange",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.units": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "path": "{view.params.path}"
          },
          "tagPath": "{path}.EngUnit"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "custom.value": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "path": "{view.params.path}"
          },
          "tagPath": "{path}"
        },
        "type": "tag"
      },
      "persistent": true
    },
    "params.path": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.title": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": "35px",
      "width": 467
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "basis": "100px",
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.custom.label"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "exchange/launchpad/oee/text/label",
            "marginRight": 5,
            "textAlign": "start"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Value"
        },
        "position": {
          "basis": "200px",
          "grow": 1
        },
        "propConfig": {
          "props.style.background": {
            "binding": {
              "config": {
                "path": "view.custom.background"
              },
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "expression": "numberFormat({view.custom.value},{view.custom.format}) + \u0027 \u0027 + {view.custom.units}"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "fontSize": "14px",
            "fontWeight": "bold",
            "padding": 7,
            "textAlign": "start"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "style": {
        "classes": "exchange/launchpad/oee/card"
      }
    },
    "type": "ia.container.flex"
  }
}