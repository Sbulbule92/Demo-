      {
        "meta": {
          "name": "LblOffsetX"
        },
        "position": {
          "height": 45,
          "width": 55,
          "x": 90,
          "y": 550
        },
        "props": {
          "text": "Offset X (mm)"
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "NumOffsetY"
        },
        "position": {
          "height": 45,
          "width": 70,
          "x": 155,
          "y": 550
        },
        "propConfig": {
          "props.value": {
            "binding": {
              "config": {
                "parameters": {
                  "ipAddress": "{../DropPrinter.props.value}"
                },
                "queryPath": "Exchange/ZPL Label Printing/Get Label Printer OffsetY",
                "returnFormat": "scalar"
              },
              "type": "query"
            }
          }
        },
        "type": "ia.input.numeric-entry-field"
      },
      {
        "meta": {
          "name": "LblOffsetY"
        },
        "position": {
          "height": 45,
          "width": 55,
          "x": 235,
          "y": 550
        },
        "props": {
          "text": "Offset Y (mm)"
        },
        "type": "ia.display.label"
      },
      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\t# clock sync from ignition each time this button is pressed\n\tnow \u003d system.date.now()\n\tzplTimeST \u003d system.date.format(now, \u0027MM,dd,yyyy,HH,mm,ss\u0027) # use format M below for military time\n\tsyncTime \u003d \"\"\"^XA^ST\"\"\" + zplTimeST + \"\"\",M^FS^XZ\"\"\"\n\tcancelPrinting \u003d \u0027~JA\u0027 # do this before printing new labels to printers every time.\n\t\n\t# get the relevant data from the perspective view components\n\tipAddress \u003d self.getSibling(\"DropPrinter\").props.value\n\tnumCopies \u003d int(self.getSibling(\"NumQtyOfLabels\").props.value) # number of copies to print\n\toffsetX \u003d int(round(8 * self.getSibling(\"NumOffsetX\").props.value, 0)) # offset in mm. multiply by 8 to get dots (8 dpmm or 203 dpi)\n\toffsetY \u003d -int(round(8 * self.getSibling(\"NumOffsetY\").props.value, 0)) # offset in mm. multiply by 8 to get dots (8 dpmm or 203 dpi) (minus should be down)\n\t\n\t# get zpl code stored on the image custom.zpl property\n\t# then replace zpl string commands to change number of copies printed and xy offsets\n\t# the number of copies for each label is defined in Plex Label Designer by the ZPL command ^PQ. e.g. ^PQ4 means 4 copies of the label will be printed.\n\t# ^LT is the offset command along the long side axis of the label, and ^LS is the offset command along the short side axis of the label\n\tlabel \u003d self.getSibling(\"ImageOfLabel\").custom.zpl\n\tlabelMultiplied \u003d label.replace(\u0027^PQ1\u0027, \u0027^PQ\u0027 + str(numCopies))\n\tlabelOffset \u003d labelMultiplied.replace(\u0027^LT0^LS0\u0027, \u0027^LT\u0027 + str(offsetX) + \u0027^LS\u0027 + str(offsetY)) \n\t\n\t# send 3 commands to the printer. Sync time from Ignition, cancel the previous job, and send the new label.\n\texchange.zplLabelPrinting.label.printLabelZPL(syncTime, ipAddress) \n\texchange.zplLabelPrinting.label.printLabelZPL(cancelPrinting, ipAddress) \n\texchange.zplLabelPrinting.label.printLabelZPL(labelOffset, ipAddress) \n\t\n\texchange.zplLabelPrinting.popup.displayMessage(\u0027Label Sent to Printer.\u0027, \u0027Label Sent to Printer\u0027)\n\t\n\t\n\t"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "BtnPrint"
        },
        "position": {
          "height": 45,
          "width": 135,
          "x": 10,
          "y": 605
        },
        "propConfig": {
          "props.enabled": {
            "binding": {
              "config": {
                "expression": "if(\r\n\t{../NumQtyOfLabels.props.value} \u003e 0\r\n\t\u0026\u0026 len({../TextZpl.props.text}) \u003e 0\r\n\t\u0026\u0026 len({../DropPrinter.props.value}) \u003e 0\r\n\t\u0026\u0026 {../IconPrinterConnection.props.path} \u003d \u0027material/check_circle\u0027 // printer must be connected with green check mark\r\n\t, true \r\n\t, false \r\n)"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "classes": "Components/brownButtons"
          },
          "text": "Print Labels"
        },
        "type": "ia.input.button"
      },
      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\t# set up command to cancel print jobs at selected printer\n\tipAddress \u003d self.getSibling(\"DropPrinter\").props.value\n\tcancelPrinting \u003d \u0027~JA\u0027\n\t\n\t# send zpl string to printer and display cancellation message\n\texchange.zplLabelPrinting.label.printLabelZPL(cancelPrinting, ipAddress)\n\texchange.zplLabelPrinting.popup.displayMessage(\u0027Previous Print Job Cancelled\u0027, \u0027Previous Print Job Cancelled\u0027)\n\t\n\t\n\t"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
