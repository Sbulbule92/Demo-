          {
            "code": "\timport random\n\tval \u003d 410 - self.custom.unplannedMinutes\n\tearnedHours \u003d (410 - self.custom.unplannedMinutes) - self.custom.Data\n\tself.custom.earnedHours \u003d earnedHours if earnedHours\u003e0 else 0\n\tself.custom.OEE.Performance \u003d int((float(self.custom.earnedHours)/val)*100)\n\tself.custom.OEE.OEE \u003d (self.custom.OEE.Availability * self.custom.OEE.Quality * self.custom.OEE.Performance)/10000\n\t\n\tif val \u003c 0 or value is None:\n\t\treturn \"00:00:00\"\n\telse:\n\t\tself.custom.OEE.Availability \u003d int((float(val)/410)*100)\n\t\t\n\t\tseconds \u003d val * 60\n\t\thr \u003d seconds/3600\n\t\tmnt \u003d (seconds % 3600)/60\n\t\tsec \u003d seconds % 60\n\t\treturn \"%02d:%02d:%02d\" % (hr, mnt, sec)",
