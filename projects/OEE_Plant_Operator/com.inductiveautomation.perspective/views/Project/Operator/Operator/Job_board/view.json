                  "code": "\tecs_data \u003d system.db.execQuery(path\u003d\u0027ecs/OP_status/get_op_status_from_ecs\u0027, parameters \u003d {\"startDate\": system.date.now(), \"endDate\": system.date.now()})\n\two_data \u003d value\n\tdata \u003d []\n\tfor row in wo_data:\n\t\tfor val in ecs_data:\n\t\t\tif row[\"serial_number\"]\u003d\u003d val[\"SerialNumber\"]:\n\t\t\t\tdata.append(row)\n#\tprint data\n\tfor rows in data:\n\t\tNewdata\u003d{\"serial_number\":rows[\"serial_number\"],\"program_name\":rows[\"program_name\"],\"work_status\":rows[\"op_status\"],\"PO\":rows[\"po_number\"]}\n\t\trows[\"work_status\"] \u003d Newdata\n\t\tprioritylbl\u003d\u0027\u0027\n\t\tif rows[\"priority\"]\u003d\u003dTrue:\n\t\t\tprioritylbl\u003d\"Yes\"\n\t\tactualturn\u003d\u0027\u0027\n\t\tif rows[\"actual_num_turns\"] \u003e0:\n\t\t\tactualturn \u003drows[\"actual_num_turns\"]\n\t\trows[\"actual_num_turns\"]\u003d\tactualturn\n\t\t\t\n\t\t\t\n\t\trows[\"priority\"]\u003dprioritylbl\t\n\treturn data ",
                  "type": "script"
                }
              ],
              "type": "query"
            }
