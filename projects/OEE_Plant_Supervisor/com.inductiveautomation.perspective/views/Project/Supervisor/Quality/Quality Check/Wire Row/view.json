      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\tsystem.perspective.sendMessage(\u0027deleteWireRow\u0027, payload\u003d{\u0027index\u0027: self.view.params.index}, scope\u003d\u0027page\u0027)"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "btnDelete"
        },
        "position": {
          "basis": "100px",
          "display": false
