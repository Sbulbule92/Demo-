              "pageScope": true,
              "script": "\t# set text area component text to the labelZPL string\n\tlabelZPL \u003d payload[\u0027labelZPL\u0027]\n\tself.props.text \u003d labelZPL",
              "sessionScope": false,
              "viewScope": false
            }
          ]
