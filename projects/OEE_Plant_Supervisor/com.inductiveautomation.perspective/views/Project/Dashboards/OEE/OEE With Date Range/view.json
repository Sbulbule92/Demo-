      }
    },
    "custom.Day_Data.OEE_Day.Performance": {
      "binding": {
        "config": {
          "expression": "toint({view.custom.Day_Data.dayProductionData.complete}/{view.custom.Day_Data.dayProductionData.target}*100)"
        },
