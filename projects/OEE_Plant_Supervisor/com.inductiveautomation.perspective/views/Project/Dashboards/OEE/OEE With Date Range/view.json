    "custom.Day_Data.OEE_Day.Availability": {
      "binding": {
        "config": {
          "expression": "coalesce(toInt(({view.custom.Day_Data.operatingTimeForDay}/{view.custom.Day_Data.TotalProductionTime})*100),0)"
