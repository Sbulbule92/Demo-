      {
        "meta": {
          "name": "IconPrinterConnection"
        },
        "position": {
          "height": 30,
          "width": 30,
          "x": 155,
          "y": 502.5
        },
        "propConfig": {
          "props.color": {
            "binding": {
              "config": {
                "path": "this.props.path"
              },
              "transforms": [
                {
                  "code": "\tif value \u003d\u003d \u0027material/check_circle\u0027:\n\t\treturn \u0027#47A770\u0027 # green\n\telif value \u003d\u003d \u0027material/swap_vertical_circle\u0027:\n\t\treturn \u0027#808080\u0027 # \u0027#3F3F3F\u0027 # gray\n\telse: # material/cancel\n\t\treturn \u0027#E22028\u0027 # red",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "path": "material/cancel"
        },
        "scripts": {
          "customMethods": [],
          "extensionFunctions": null,
          "messageHandlers": [
            {
              "messageType": "exchange.zplLabelPrinting.getPrinterConnectionStatus",
              "pageScope": true,
              "script": "\t# use os library to ping printer IP, with ping count 2\n\timport os\n\t\n\tstatus \u003d \u0027material/swap_vertical_circle\u0027\n\tself.props.path \u003d status\n\t\n\tip \u003d payload[\u0027ip\u0027]\n\tconnected \u003d os.system(\"ping /n 2 \" + str(ip)) \u003d\u003d 0 # Windows 10, 11, Server 2016+\n\t#connected \u003d os.system(\"ping -c 2 \" + str(ip)) \u003d\u003d 0 # OS X or Linux\n\t\n\tif connected \u003d\u003d True:\n\t\tstatus \u003d \u0027material/check_circle\u0027\n\telse:\n\t\tstatus \u003d \u0027material/cancel\u0027\n\t\n\tself.props.path \u003d status",
              "sessionScope": false,
              "viewScope": false
            }
          ]
        },
        "type": "ia.display.icon"
      },
