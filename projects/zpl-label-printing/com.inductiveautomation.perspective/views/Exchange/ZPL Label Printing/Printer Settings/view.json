          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\t# display confirmation popup before proceeding to run attached message handler\n\tconfirmMessage \u003d \u0027Please confirm you wish to remove this printer.\u0027\n\texchange.zplLabelPrinting.popup.displayConfirmation(confirmMessage)\n\t"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "BtnPrinterDelete"
            },
            "position": {
              "height": 45,
              "width": 135,
              "x": 1055,
              "y": 130
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "config": {
                    "expression": "if(\r\n\t{../TablePrinterSettings.props.selection.selectedRow} !\u003d null \r\n\t, true \r\n\t, false \r\n)"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "classes": "Components/brownButtons"
              },
              "text": "Delete Printer"
            },
            "scripts": {
              "customMethods": [],
              "extensionFunctions": null,
              "messageHandlers": [
                {
                  "messageType": "exchange.zplLabelPrinting.confirmPopup",
                  "pageScope": true,
                  "script": "\t# delete selected record from sql\n\t# postgresql database connection in Ignition gateway is named \u0027ex_zpl_label_printing\u0027\n\tprinterName \u003d self.getSibling(\"TablePrinterSettings\").props.selection.data[0].printer_name\n\t\n\tdeletePrinter \u003d \"\"\"\n\t\tdelete from ex_zpl_label_printing.ex_zlp_label_printer_settings \n\t\twhere printer_name \u003d ? \n\t\"\"\"\n\tr \u003d system.db.runPrepUpdate(deletePrinter, [printerName], \u0027ex_zpl_label_printing\u0027)\n\t\n\tsystem.perspective.sendMessage(\u0027exchange.zplLabelPrinting.refreshPrinterSettings\u0027, scope\u003d\u0027page\u0027)\n\texchange.zplLabelPrinting.popup.displayMessage(\u0027Removed Printer\u0027, \u0027Successfully removed printer from list!\u0027)\n\t\n\t\n\t",
                  "sessionScope": false,
                  "viewScope": true
                }
              ]
            },
            "type": "ia.input.button"
          }
