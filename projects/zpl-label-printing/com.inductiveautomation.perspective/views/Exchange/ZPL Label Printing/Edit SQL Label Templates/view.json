          "messageHandlers": [
            {
              "messageType": "exchange.zplLabelPrinting.refreshLabelNames",
              "pageScope": true,
              "script": "\t# initialize dropdown options with ability to select a new template\n\tself.props.options \u003d [{\u0027label\u0027 : \u0027\u003cNew\u003e\u0027 , \u0027value\u0027 : \u0027New\u0027 }]\n\t\n\t# get list of label names and populate dropdown component with them\n\tgetLabelFromSQL \u003d \"\"\"\n\t\tselect label_name\n\t\tfrom ex_zpl_label_printing.ex_zlp_label_templates \n\t\torder by label_name \n\t\"\"\"\n\tlabel_DS \u003d system.db.runPrepQuery(getLabelFromSQL, [], \u0027ex_zpl_label_printing\u0027) # postgres db\n\t\n\tfor row in range(label_DS.getRowCount()):\n\t\tlabelName \u003d label_DS.getValueAt(row, \u0027label_name\u0027)\n\t\t#labelZPL \u003d label_DS.getValueAt(row, \u0027label_zpl_template\u0027)\n\t\tself.props.options.append({\u0027label\u0027 : labelName , \u0027value\u0027 : labelName })\n\t\n\t\n\t",
              "sessionScope": false,
              "viewScope": true
            }
          ]
        },
        "type": "ia.input.dropdown"
      },
      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\t# refresh zpl code with whatever is in the text area component\n\tlabelInfo \u003d {}\n\tlabelInfo[\u0027labelZPL\u0027] \u003d self.getSibling(\"TextZpl\").props.text\n\tsystem.perspective.sendMessage(\u0027exchange.zplLabelPrinting.getLabelaryImage\u0027, scope\u003d\u0027page\u0027, payload\u003dlabelInfo)\n\t\n\t\n\t"
              },
