    "params.user": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 854,
      "width": 1196
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Label_username"
        },
