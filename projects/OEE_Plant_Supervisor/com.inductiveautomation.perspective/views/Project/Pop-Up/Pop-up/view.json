            "position": {
              "basis": "150px"
            },
            "propConfig": {
              "meta.visible": {
                "binding": {
                  "config": {
                    "expression": "if(lower({view.params.action})\u003d\"success\",False,True)"
                  },
                  "type": "expr"
                }
