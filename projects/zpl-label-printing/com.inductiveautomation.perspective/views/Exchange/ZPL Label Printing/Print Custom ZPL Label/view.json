        },
        "propConfig": {
          "meta.visible": {
            "binding": {
              "config": {
                "path": "../DropTemplates.props.value"
              },
              "transforms": [
                {
                  "code": "\tif \u0027parameter\u0027 in value.lower():\n\t\treturn True \n\telse:\n\t\treturn False \n\t",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "direction": "column",
          "path": "Exchange/ZPL Label Printing/Label Parameters Template"
        },
        "scripts": {
          "customMethods": [],
          "extensionFunctions": null,
          "messageHandlers": [
            {
              "messageType": "exchange.zplLabelPrinting.getLabelParameters",
              "pageScope": true,
              "script": "\t# when the labelZPL text comes to this component, use regex to find all [parameters] inside\n\timport re \n\t\n\tlabelZPL \u003d payload[\u0027labelZPL\u0027]\n\tparametersFound \u003d re.findall(\"\\[[^\\]]+\\]\", labelZPL) # list returned of all values wrapped in [brackets]\n\t\n\t# create unique list of parameters from parametersFound list\n\tparameters \u003d []\n\tfor p in parametersFound:\n\t\tif p not in parameters:\n\t\t\tparameters.append(p)\n\t\n\t# now reset instances on flex repeater and add each parameter as a separate instance, keeping default json structure\n\tself.props.instances \u003d [] \n\tfor p in parameters:\n\t\tself.props.instances.append({ \n\t\t\t\u0027instanceStyle\u0027 : { \u0027classes\u0027 : \u0027\u0027 }\n\t\t\t, \u0027instancePosition\u0027 : {} \n\t\t\t, \u0027parameterName\u0027 : p\n\t\t\t, \u0027parameterValue\u0027 : p \n\t\t}) \n\t\n\t\n\t",
              "sessionScope": false,
              "viewScope": false
            }
          ]
        },
        "type": "ia.display.flex-repeater"
      },
      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\t# refresh the zpl string on the Image component\n\t\n\t# first check the label name to see if it contains the word \u0027parameter\u0027 or \u0027parameterized\u0027\n\tlabelName \u003d self.getSibling(\"DropTemplates\").props.value\n\tlabelZPL \u003d self.getSibling(\"TextZpl\").props.text\n\t\n\t# if the label is [parameterized], use the parameters to change the zpl on the Image component\n\tif \u0027parameter\u0027 in labelName.lower():\n\t\tlabelParameterInstances \u003d self.getSibling(\"FlexRepeaterLabelParameters\").props.instances\n\t\t\n\t\t# loop through parameters and iteratively replace each [parameterName] with the corresponding value\n\t\tfor i in labelParameterInstances:\n\t\t\tlabelZPL \u003d labelZPL.replace(i[\u0027parameterName\u0027], i[\u0027parameterValue\u0027])\n\t\t\n\t# refresh zpl code on only the image component\n\tlabelInfo \u003d {}\n\tlabelInfo[\u0027labelZPL\u0027] \u003d labelZPL\n\tsystem.perspective.sendMessage(\u0027exchange.zplLabelPrinting.getLabelaryImage\u0027, scope\u003d\u0027page\u0027, payload\u003dlabelInfo)\n\t\n\t\n\t"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
