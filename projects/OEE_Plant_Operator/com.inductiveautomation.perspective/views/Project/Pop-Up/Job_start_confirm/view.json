            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tworkstatus\u003dself.view.params.work_status\t\n\tif workstatus \u003d\u003d 2:\n\t\taction \u003d 4  #started to ECs and ignition\n\t\toprremark\u003d\u0027started\u0027\n\telif workstatus \u003d\u003d 4:\n\t\taction \u003d 16\n\t\toprremark\u003d\u0027completed\u0027\n\telif workstatus \u003d\u003d18 :\n\t\taction \u003d 4\n\t\toprremark\u003d\u0027restarted\u0027\n\t\tecsstatus\u003d1\n\tNQ\u003d \"ecs/workorder/Update_Workstatus_to_ECS\"\n\tserial_number\u003dself.view.params.serial_number\n\tprogram_name\u003dself.view.params.program_name\n\tPO_Number\u003dself.view.params.PO\n\tEquipment\u003dself.session.custom.machineInfo.EquipmentName\n\tECSUser\u003dself.session.custom.machineInfo.OPRID\n\tmachine_id\u003dself.session.custom.machineInfo.ID\n\tsessionuser\u003dself.session.props.auth.user.userName\n\tstarttime\u003dsystem.date.now()\n\tif workstatus!\u003d18:\n\t\tecsstatus\u003d0\n\t\tparams \u003d{\"Serial_Number\":serial_number,\"Equipment\":Equipment,\"PO_Number\":PO_Number,\"action\":action,\"ECSUser\":ECSUser}\n\t\t#system.perspective.print(str(params))\n\t\tecsreturnresult\u003dsystem.db.runNamedQuery(path\u003dNQ, parameters\u003dparams)\n\t\tMachineresponseFeedback \u003d system.db.runNamedQuery(path\u003d\"ecs/workorder/Machine_Response_Status\", parameters\u003d{\"Serial_Num\":serial_number,\"action\":action})\n\t\tecsstatus\u003dMachineresponseFeedback.getValueAt(0,\"MR_Status_Flag\")\n\tif ecsstatus\u003d\u003d1:\n\t\tlocalparams\u003d{\"serial_number\":serial_number,\"po_number\":PO_Number,\"op_status\":action,\"machine_id\":machine_id,\"user_name\":sessionuser}\n\t\tlocalreturn\u003dsystem.db.runNamedQuery(path\u003d\"ecs/workorder/Update_Workstatus_local\", parameters\u003dlocalparams)\n\t\tif localreturn \u003e 0 :\n\t\t\tbasepath\u003dself.session.custom.machineInfo.basePath\n\t\t\tRWtagPaths \u003dwo.machine.build_tagpath_RW(basepath)\n\t\t\tROtagPaths \u003dwo.machine.build_tagpath_RO(basepath)\n\t\t\tWIP_actualturn\u003dwo.machine.get_machine_status(ROtagPaths)\n\t\t\ttaglist\u003dRWtagPaths[:-1]\n\t\t\tEventQuery \u003d \u0027ecs/workorder/op_event/insertEvent\u0027\n\t\t\tparams \u003d {\"serial_number\":serial_number,\"event_type_id\": action,\"userName\": sessionuser,\"wip\": WIP_actualturn[0].value,\"actual_num_turns\": WIP_actualturn[1].value,\"machine_id\": machine_id,\"remarks\":oprremark}\n\t\t\tupdateresult\u003dsystem.db.execUpdate(path \u003d EventQuery, parameters\u003dparams)\n\t\t\tif action \u003d\u003d 4:\t\n\t\t\t\t#system.tag.writeBlocking(taglist,[PO_Number,serial_number,starttime,action,False,program_name])\n\t\t\t\ttagvalues\u003d[PO_Number,serial_number,starttime,action,False,program_name]\n\t\t\t\two.machine.update_machine_status(taglist,tagvalues)\n\t\t\t\tsystem.tag.writeBlocking([\"Ignition_Project_Config/Opr_updated_wo\"], [True])\n\t\t\t\tsystem.perspective.closePopup(\u0027PopUp\u0027)\n\t\t\t\tparams\u003d{\"jobid\":serial_number,\"program\":program_name,\"workstatus\":action}\n\t\t\t\tsystem.perspective.navigate(page\u003d\u0027/opr_wip\u0027, params\u003dparams)\n\t\t\telif action \u003d\u003d 16:\n\t\t\t\t#system.tag.writeBlocking(taglist,[\u0027\u0027,\u0027\u0027,\"\",0,False,\u0027\u0027])\n\t\t\t\ttagvalues\u003d[\u0027\u0027,\u0027\u0027,\"\",0,False,\u0027\u0027]\n\t\t\t\two.machine.update_machine_status(taglist,tagvalues)\n\t\t\t\tsystem.tag.writeBlocking([\"Ignition_Project_Config/Opr_updated_wo\"], [True])\n\t\t\t\tsystem.perspective.closePopup(\u0027PopUp\u0027)\n\t\t\t\tparams \u003d {\"action\": \"success\", \"primaryText\": \"Job Completed successfully!\", \"secondaryText\":\" \"}\n\t\t\t\tsystem.perspective.openPopup(\"PopUp\", view \u003d \"Project/Pop-Up/Pop-up\", \n\t\t\t\t\t\t\t\t\t\t\tparams \u003d params, \n\t\t\t\t\t\t\t\t\t\t\tshowCloseIcon \u003d False,\n\t\t\t\t\t\t\t\t\t\t\tdraggable \u003d False, \n\t\t\t\t\t\t\t\t\t\t\tmodal \u003d True)\n\t\t\t\tsystem.perspective.navigate(page\u003d\u0027/opr_job_board\u0027)\n\t\telse:\n\t\t\tsystem.perspective.closePopup(\u0027PopUp\u0027)\n\t\t\tparams \u003d {\"action\": \"error\", \"primaryText\": \"Something went wrong in Metadata table!\", \"secondaryText\":\" \"}\n\t\t\tsystem.perspective.openPopup(\"PopUp\", view \u003d \"Project/Pop-Up/Pop-up\", \n\t\t\t\t\t\t\t\t\t\t\tparams \u003d params, \n\t\t\t\t\t\t\t\t\t\t\tshowCloseIcon \u003d False,\n\t\t\t\t\t\t\t\t\t\t\tdraggable \u003d False, \n\t\t\t\t\t\t\t\t\t\t\tmodal \u003d True)\n\t\t\t\n"
                  },
