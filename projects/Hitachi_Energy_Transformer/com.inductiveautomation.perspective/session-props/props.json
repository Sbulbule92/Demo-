{
  "custom": {},
  "propConfig": {
    "custom.Downtime_entry_pending": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "direct",
          "tagPath": "[default]pending_downtime"
        },
        "type": "tag"
      },
      "onChange": {
        "enabled": null,
        "script": "\tif  currentValue.value \u003e 0 :\n\t\tsystem.perspective.sendMessage(\"openGatewayPopup\", scope\u003d\"session\")"
      }
    },
    "custom.idealsessionTime": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "direct",
          "tagPath": "[default]WOCL_1/Downtime/Ideal_time/duration"
        },
        "type": "tag"
      },
      "onChange": {
        "enabled": null,
        "script": "\tif currentValue.value \u003d\u003d 2 :\n\t\tsystem.perspective.sendMessage(messageType\u003d\"logoutOPR\", payload\u003d{}, scope\u003d\"session\")"
      }
    },
    "props.auth": {
      "access": "PRIVATE",
      "persistent": false
    },
    "props.device.accelerometer": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.device.identifier": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.device.timezone": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.device.type": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.device.userAgent": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.gateway": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.geolocation.data": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.geolocation.permissionGranted": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.host": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.id": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.lastActivity": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.offline.capable": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.offline.enabled": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.offline.lastSynced": {
      "access": "SYSTEM",
      "persistent": false
    }
  },
  "props": {
    "address": "127.0.0.1",
    "device": {},
    "geolocation": {},
    "locale": "en-IN",
    "offline": {},
    "theme": "light-cool",
    "timeZoneId": "Asia/Calcutta"
  }
}