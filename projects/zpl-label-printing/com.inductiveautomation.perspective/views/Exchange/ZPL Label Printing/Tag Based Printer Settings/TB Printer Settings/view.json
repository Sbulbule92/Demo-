            "scripts": {
              "customMethods": [],
              "extensionFunctions": null,
              "messageHandlers": [
                {
                  "messageType": "exchange.zplLabelPrinting.getPrinterListFromTags",
                  "pageScope": true,
                  "script": "\t# this script will pull the tag info only once each time this component is loaded onto the view\n\t# this dropdown will not update automatically after tag value change, until view is exited and re-entered\n\t\n\t# reset options on self and reset custom list of labelPrinterSettings\n\tself.props.options \u003d []\n\tself.custom.labelPrinterSettings \u003d []\n\t\n\t# browse all udt instances in LabelPrinterSettings tag folder\n\tresults \u003d system.tag.browse(\n\t\tpath \u003d \u0027[default]Exchange/LabelPrinterSettings\u0027\n\t\t, filter \u003d {\n\t\t\t\u0027name\u0027:\u0027Printer*\u0027\n\t\t\t, \u0027tagType\u0027: \u0027UdtInstance\u0027\n\t\t\t, \u0027typeID\u0027:\u0027LabelPrinterSettings\u0027\n\t\t}\n\t)\n\t\n\t# go deeper to get the meta udtNames and tag paths for each instance\n\tudtNames \u003d []\n\ttagPaths \u003d []\n\tfor result in results.getResults():\n\t\t#print result\n\t\t#print result[\u0027name\u0027]\n\t\tresults2 \u003d system.tag.browse(path \u003d result[\u0027fullPath\u0027], filter \u003d {})\n\t\tfor result2 in results2.getResults():\n\t\t\t#print result2[\u0027fullPath\u0027], result2[\u0027name\u0027]\n\t\t\tudtNames.append(str(result2[\u0027name\u0027]))\n\t\t\ttagPaths.append(str(result2[\u0027fullPath\u0027]))\n\ttagValues \u003d system.tag.readBlocking(tagPaths)\n\t\n\t# initialize some arrays, extract the info stored in each udt instance, and add to arrays\n\tnames \u003d []\n\tips \u003d []\n\toffsetsX \u003d []\n\toffsetsY \u003d []\n\tfor t in range(len(tagValues)):\n\t\tif udtNames[t] \u003d\u003d \u0027name\u0027:\n\t\t\tnames.append(tagValues[t].value)\n\t\telif udtNames[t] \u003d\u003d \u0027ipAddress\u0027:\n\t\t\tips.append(tagValues[t].value)\n\t\telif udtNames[t] \u003d\u003d \u0027offsetX\u0027:\n\t\t\toffsetsX.append(tagValues[t].value)\n\t\telif udtNames[t] \u003d\u003d \u0027offsetY\u0027:\n\t\t\toffsetsY.append(tagValues[t].value)\n\t\n\tfor i in range(len(ips)):\n\t\toption \u003d { \n\t\t\t\u0027label\u0027 : names[i]\n\t\t\t, \u0027value\u0027 : ips[i] \n\t\t}\n\t\tself.props.options.append(option)\n\t\t\n\t\tprinterDetail \u003d { \n\t\t\t\u0027printerName\u0027 : names[i]\n\t\t\t, \u0027ipAddress\u0027 : ips[i]\n\t\t\t, \u0027offsetX\u0027 : offsetsX[i]\n\t\t\t, \u0027offsetY\u0027 : offsetsY[i]\n\t\t}\n\t\tself.custom.labelPrinterSettings.append(printerDetail)\n\t\n\t\n\t",
                  "sessionScope": false,
                  "viewScope": false
                }
              ]
            },
            "type": "ia.input.dropdown"
          },
