                      "script": "\tserial \u003d self.view.params.rowData.serial_number\n\tpriority \u003d self.view.params.rowData.priority\n\tlogger \u003d system.util.getLogger(\"Test\")\n\tlogger.info(str(priority))\n\tif not priority:\n\t\tprimaryText \u003d \"Do you really want to cancel %s?\" % serial\n\t\t\n\t\tsecondaryText \u003d \"Warning: You are about to hold Serial No. {serial}. This action will mark hold to work order. Do you wish to proceed?\".format(serial\u003dserial)\n\t\tparams \u003d {\n\t\t\t\"action\" : \"confirm\",\n\t\t\t\"primaryText\":primaryText,\n\t\t\t\"secondaryText\": secondaryText,\n\t\t\t\"restart\" : False,\n\t\t\t\"payload\" :self.view.params.rowData,\n\t\t\t\"event_id\": self.view.custom.event_id,\n\t\t\t\"reason\": self.view.custom.reason\n\t\t}\n\t\t\n\t\tsystem.perspective.openPopup(id \u003d \"confirm\", \n\t\t\t\t\t\t\t\t\tview \u003d \"Project/Supervisor/Job Cancell/Pop-up\", \n\t\t\t\t\t\t\t\t\tparams \u003d params,\n\t\t\t\t\t\t\t\t\tshowCloseIcon \u003d False,\n\t\t\t\t\t\t\t\t\tdraggable \u003d False,\n\t\t\t\t\t\t\t\t\tmodal \u003d True)\n\t\tself.view.custom.visibility \u003d False\n\telif priority :\n\t\tprimaryText \u003d \"Please remove the priority of %s to update the status?\" % serial\n\t\t\n\t\tsecondaryText \u003d \"Error: You need to remove priority for Serial No. {serial}.\".format(serial\u003dserial)\n\t\tparams \u003d {\n\t\t\t\"action\" : \"error\",\n\t\t\t\"primaryText\":primaryText,\n\t\t\t\"secondaryText\": secondaryText,\n\t\t\t\"restart\" : False,\n\t\t\t\"payload\" :self.view.params.rowData,\n\t\t\t\"event_id\": self.view.custom.event_id,\n\t\t\t\"reason\": self.view.custom.reason\n\t\t}\n\t\t\n\t\tsystem.perspective.openPopup(id \u003d \"confirm\", \n\t\t\t\t\t\t\t\t\tview \u003d \"Project/Supervisor/Job Cancell/Pop-up\", \n\t\t\t\t\t\t\t\t\tparams \u003d params,\n\t\t\t\t\t\t\t\t\tshowCloseIcon \u003d False,\n\t\t\t\t\t\t\t\t\tdraggable \u003d False,\n\t\t\t\t\t\t\t\t\tmodal \u003d True)\n\t\tself