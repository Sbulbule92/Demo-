    "custom.styles": {
      "binding": {
        "config": {
          "path": "view.params.action"
        },
        "transforms": [
          {
            "code": "\tstyles \u003d []\n\tif str(value).lower()\u003d\u003d\"save\":\n\t\tstyle \u003d {\n\t\t\t\"icon\": \"material/save\",\n\t\t\t\"iconColor\": \"#3272d9\",\n\t\t\t\"primaryButtonText\": \"SAVE\",\n\t\t\t\"primaryButtonColor\": \"#3272d9\",\n\t\t\t\"SecondaryButtonTextColor\": \"#3272d9\"\n\t\t}\n\telif str(value).lower()\u003d\u003d\"update\":\n\t\tstyle \u003d {\n\t\t\t\"icon\": \"material/system_update_alt\",\n\t\t\t\"iconColor\": \"#3272d9\",\n\t\t\t\"primaryButtonText\": \"UPDATE\",\n\t\t\t\"primaryButtonColor\": \"#3272d9\",\n\t\t\t\"SecondaryButtonTextColor\": \"#3272d9\"\n\t\t}\n\telif str(value).lower()\u003d\u003d\"delete\":\n\t\tstyle \u003d {\n\t\t\t\"icon\": \"material/delete\",\n\t\t\t\"iconColor\": \"var(--error)\",\n\t\t\t\"primaryButtonText\": \"DELETE\",\n\t\t\t\"primaryButtonColor\": \"var(--error)\",\n\t\t\t\"SecondaryButtonTextColor\": \"var(--error)\"\n\t\t}\n\telif str(value).lower()\u003d\u003d\"success\":\n\t\tstyle \u003d {\n\t\t\t\"icon\": \"material/check_circle\",\n\t\t\t\"iconColor\": \"var(--success)\",\n\t\t\t\"primaryButtonText\": \"DONE\",\n\t\t\t\"primaryButtonColor\": \"var(--success)\",\n\t\t\t\"SecondaryButtonTextColor\": \"var(--success)\"\n\t\t}\n\telif str(value).lower()\u003d\u003d\"error\":\n\t\tstyle \u003d {\n\t\t\t\"icon\": \"material/error\",\n\t\t\t\"iconColor\": \"var(--error)\",\n\t\t\t\"primaryButtonText\": \"OK\",\n\t\t\t\"primaryButtonColor\": \"var(--error)\",\n\t\t\t\"SecondaryButtonTextColor\": \"var(--error)\"\n\t\t}\n\telif str(value).lower()\u003d\u003d\"info\":\n\t\tstyle \u003d {\n\t\t\t\"icon\": \"material/info\",\n\t\t\t\"iconColor\": \"var(--info)\",\n\t\t\t\"primaryButtonText\": \"OK\",\n\t\t\t\"primaryButtonColor\": \"var(--info)\",\n\t\t\t\"SecondaryButtonTextColor\": \"var(--info)\"\n\t\t}\n\telif str(value).lower()\u003d\u003d\"warning\":\n\t\tstyle \u003d {\n\t\t\t\"icon\": \"material/warning\",\n\t\t\t\"iconColor\": \"var(--warning)\",\n\t\t\t\"primaryButtonText\": \"OK\",\n\t\t\t\"primaryButtonColor\": \"var(--warning)\",\n\t\t\t\"SecondaryButtonTextColor\": \"var(--warning)\"\n\t\t}\n\telif str(value).lower()\u003d\u003d\"confirm\":\n\t\tstyle \u003d {\n\t\t\t\"icon\": \"material/notifications_active\",\n\t\t\t\"iconColor\": \"var(--warning)\",\n\t\t\t\"primaryButtonText\": \"Confirm\",\n\t\t\t\"primaryButtonColor\": \"var(--warning)\",\n\t\t\t\"SecondaryButtonTextColor\": \"var(--warning)\"\n\t\t}\n\telse:\n\t\tstyle \u003d {\n\t\t\t\"icon\": \"material/info\",\n\t\t\t\"iconColor\": \"var(--info)\",\n\t\t\t\"primaryButtonText\": \"OK\",\n\t\t\t\"primaryButtonColor\": \"var(--info)\",\n\t\t\t\"SecondaryButtonTextColor\": \"var(--info)\"\n\t\t}\n\tstyles.append(style)\n\treturn styles",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
