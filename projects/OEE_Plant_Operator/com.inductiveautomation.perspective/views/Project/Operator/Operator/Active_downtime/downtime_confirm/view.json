    "system": {
      "onStartup": {
        "config": {
          "script": "\tself.getChild(\"root\").getChild(\"FlexContainer\").getChild(\"downtime_desc_flex\").getChild(\"TextArea\").props.text\u003d\u0027\u0027\n\tparameters\u003d{\"MachineID\":self.session.custom.machineInfo.ID}\n\tCurrentData \u003d system.db.runNamedQuery(\"downtime/Active_downtime\", parameters)\n\tSelected_reason\u003dCurrentData.getValueAt(0,\"ReasonID\")\n\tDowntimeSource\u003dCurrentData.getValueAt(0,\"DowntimeSource\")\n\tStartDate\u003dCurrentData.getValueAt(0,\"StartTime\")\n\tEndTime\u003dCurrentData.getValueAt(0,\"EndTime\")\n\tLogID\u003dCurrentData.getValueAt(0,\"LogID\")\n\tdowntimedesc\u003dCurrentData.getValueAt(0,\"Remarks\")\n\tif Selected_reason in [16,17] :\n\t\tSelected_reason\u003d-1\n\tself.getChild(\"root\").custom.DowtimeSource\u003dDowntimeSource\n\tself.getChild(\"root\").custom.LogID\u003dLogID\n\tself.getChild(\"root\").getChild(\"FlexContainer\").getChild(\"Reasonflex\").getChild(\"Dropdown\").props.value\u003dSelected_reason\n\tself.getChild(\"root\").getChild(\"FlexContainer\").getChild(\"downtime_inprogress_flex\").getChild(\"Checkbox\").props.selected\u003dTrue\n\tself.getChild(\"root\").getChild(\"FlexContainer\").getChild(\"Start_time_flex\").getChild(\"DateTimeInput\").props.value\u003dStartDate\n\tself.getChild(\"root\").getChild(\"FlexContainer\").getChild(\"downtime_desc_flex\").getChild(\"TextArea\").props.text\u003ddowntimedesc"
        },
        "scope": "G",
        "type": "script"
      }
    }
  },
