                "binding": {
                  "config": {
                    "expression": "True"
                  },
                  "transforms": [
                    {
                      "code": "\tuser \u003d self.session.props.auth.user.userName\n\tgatewayStatus \u003d  \u0027Connected\u0027 if self.session.props.gateway.connected else \u0027Disconnected\u0027\n\tgatewayVersion \u003d system.util.getVersion()\n\tbaseStr \u003d( \u0027 | \u0027 + system.tag.readBlocking(\u0027[default]Current_Shift/shift_Code\u0027)[0].value\n\t\t\t\t\t + \u0027 | \u0027 + \u0027Plant: Jefferson City\u0027\n#\t\t\t\t\t + \u0027 | \u0027 + \u0027Project - \u0027 + str(system.project.getProjectName()) \n#\t\t\t\t\t + \u0027 | \u0027 + \u0027Gateway Address: \u0027 + str(self.session.props.gateway.address)\n#\t\t\t\t\t + \u0027 | \u0027 + \u0027Gateway Status: \u0027 + gatewayStatus\n#\t\t\t\t\t + \u0027 | \u0027 + \u0027Host:\u0027 + self.session.props.host\n#\t\t\t\t\t + \u0027 | \u0027 + \u0027Timezone:\u0027 + self.session.props.timeZoneId\n#\t\t\t\t\t + \u0027 | \u0027 + str(gatewayVersion) \n#\t\t\t\t\t + \u0027 | \u0027 + \u0027Hitachi Digital Services\u0027\n\t\t\t)\n\t\t\t\t\t \n#\tif user is None or user \u003d\u003d\u0027\u0027:\n#\t\tuser \u003d \u0027Guest\u0027.upper() + baseStr\n#\t\treturn user\n#\telse:\n#\t\treturn str(user).upper() + baseStr\n\treturn \u0027Ignition Version: \u0027 + str(system.util.getVersion())",
                      "type": "script"
                    }
                  ],
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "marginLeft": "5px"
              },
              "textStyle": {
                "alignSelf": "flex-start",
                "fontSize": "13px",
                "fontWeight": "600"
              }
            },
            "scripts": {
              "customMethods": [],
              "extensionFunctions": null,
              "messageHandlers": [
                {
                  "messageType": "footerLebelRefresh",
                  "pageScope": true,
                  "script": "\t# implement your handler here\n\tself.refreshBinding(\"props.text\")",
                  "sessionScope": false,
                  "viewScope": true
                }
              ]
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "BottomFlex_0"
        },
        "props": {
          "style": {
            "marginLeft": "1px"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "propConfig": {
      "props.style.backgroundColor": {
        "binding": {
          "config": {
            "path": "session.props.theme"
          },
          "transforms": [
            {
              "code": "\treturn \"#31384C\" if \"light\" in value else \"--neutral-90\"",
              "type": "script"
            }
          ],
          "type": "property"
        }
      }
    },
    "props": {
      "justify": "space-evenly",
      "style": {
        "borderBottomStyle": "none",
        "borderLeftStyle": "none",
        "borderRightStyle": "none",
        "borderTopColor": "#808080",
        "borderTopStyle": "solid",
