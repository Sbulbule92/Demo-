                        "script": "\tReasonID   \u003d  self.parent.parent.getChild(\"reasonflex\").getChild(\"Dropdown\").props.value\n\tStartTime  \u003d  self.parent.parent.getChild(\"Start_time_flex\").getChild(\"DateTimeInput\").props.value\n\tEndTime    \u003d  self.parent.parent.getChild(\"end_time_flex\").getChild(\"DateTimeInput\").props.value\n\tRemarks    \u003d  self.parent.parent.getChild(\"downtime_desc_flex\").getChild(\"TextArea\").props.text\n\tSupervisor \u003d  self.session.props.auth.user.userName\n\tLogID      \u003d  self.view.params.logID\n\tparameters \u003d { \"ReasonID\"   :ReasonID,\n\t\t\t\t\t\"StartTime\" :StartTime,\n\t\t\t\t\t\"EndTime\"   :EndTime,\n\t\t\t\t\t\"Remarks\"   :Remarks,\n\t\t\t\t\t\"Supervisor\":Supervisor,\n\t\t\t\t\t\"LogID\":LogID} \n\tsystem.db.execUpdate(\"Operator Overview/updateDowntime\", parameters)\n\n\tsystem.perspective.sendMessage(\u0027refreshBinding\u0027, scope\u003d\u0027page\u0027)\n\tparams \u003d {\"action\": \"success\", \"primaryText\": \"Downtime logged successfully!\", \"secondaryText\":\" \",\"label\":\"manual downtime\"}\n\tsystem.perspective.openPopup(\"PopUp\", view \u003d \"Project/Pop-Up/Pop-up\", \n\t\t\t\t\t\t\t\t\tparams \u003d params, \n\t\t\t\t\t\t\t\t\tshowCloseIcon \u003d False,\n\t\t\t\t\t\t\t\t\tdraggable \u003d False, \n\t\t\t\t\t\t\t\t\tmodal \u003d True)\n\tsystem.perspective.closePopup(id \u003d \u0027PopUp1\u0027)\n#\t#categorydowntime \u003dself.parent.parent.getChild(\"down_cat_flex\").getChild(\"Dropdown\").props.value\n#\tlogID\u003dself.view.params.logID\n#\treasondowntime \u003d self.parent.parent.getChild(\"reasonflex\").getChild(\"Dropdown\").props.value\n#\tinprogressdowntime\u003dFalse\n#\tstarttime\u003dself.parent.parent.getChild(\"Start_time_flex\").getChild(\"DateTimeInput\").props.value\n#\tEndTime\u003dself.parent.parent.getChild(\"end_time_flex\").getChild(\"DateTimeInput\").props.value\n#\tshift\u003dsystem.tag.readBlocking(\"[default]Current_Shift/shift_ID\")[0].value\n#\tdescdowntime\u003dself.parent.parent.getChild(\"downtime_desc_flex\").getChild(\"TextArea\").props.text\n#\tuser\u003dself.session.props.auth.user.userName\n#\terrorcode\u003d\u0027\u0027\n##\tif categorydowntime \u003c 1 :\n##\t\terrorcode\u003d \"Please select a Downtime category\"\n#\tif reasondowntime \u003c 1 :\n#\t\terrorcode\u003d \"Please select a Downtime reason\"\n#\telif starttime is None :\n#\t\terrorcode\u003d \"Please select start time\"\n##\telif inprogressdowntime \u003d\u003d False and EndTime is None:\n##\t\terrorcode\u003d \"Please select end time\"\n#\telif len(descdowntime) \u003c\u003d 4 and  reasondowntime\u003d\u003d36:\n#\t\terrorcode\u003d \"Please provide downtime description \"\n#\telse:\n#\t\t\t\tsystem.perspective.closePopup(\u0027PopUp1\u0027)\n#\t\tif inprogressdowntime :\n#\t\t\t#breakdown in progress\n#\t\t\t#parameters \u003d {\"CategoryID\":categorydowntime, \"ReasonID\":reasondowntime, \"Remarks\":descdowntime, \"DowntimeStatus\":not inprogressdowntime,\"username\":user,\"StartTime\":starttime} \n#\t\t\tparameters \u003d { \"ReasonID\":reasondowntime, \"DowntimeStatus\":False,\"username\":user,\"StartTime\":starttime,\"ShiftID\":shift,\"DowntimeSource\":0,\"Remarks\":descdowntime} \n#\t\t\t# Run the Named Query\n#\t\t\tsystem.db.runNamedQuery(\"downtime/insert\", parameters)\n#\t\telse:\n#\t\t\t#breakdowncompleted\n#\t\t\t\n#\t\t\t#parameters \u003d {\"CategoryID\":categorydowntime, \"ReasonID\":reasondowntime, \"Remarks\":descdowntime, \"DowntimeStatus\":not inprogressdowntime,\"username\":user,\"StartTime\":starttime,\"EndTime\":EndTime} \n#\t\t\tparameters \u003d {\"ReasonID\":reasondowntime,  \"DowntimeStatus\":False,\"username\":user,\"StartTime\":starttime,\"EndTime\":EndTime,\"ShiftID\":shift,\"DowntimeSource\":0,\"Remarks\":descdowntime} \n## Run the Named Query\n#\t\t\tsystem.db.runNamedQuery(\"downtime/insert_completed\", parameters)\n#\t\n#\tself.getSibling(\"Label\").props.text\u003d errorcode\n#\t#system.perspective.navigate(url\u003d\"http://localhost:8088/data/perspective/client/Shiva_Hitachi/opr_job_board\")"
