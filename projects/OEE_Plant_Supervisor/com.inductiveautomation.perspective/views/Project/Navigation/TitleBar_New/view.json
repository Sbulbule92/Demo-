    "custom.Blink": {
      "binding": {
        "config": {
          "expression": "now(500)"
        },
        "transforms": [
          {
            "code": "    dt \u003d system.date.now()\n    timeLimit \u003d system.date.addHours(dt, -24)\n    props \u003d [(\"eventtime\", \"\u003e\", timeLimit)]\n#    ackAlarms   \u003d system.alarm.queryStatus(state \u003d [\"ActiveAcked\"], path \u003d [\"*Press*\"], any_properties \u003d props)\n    \n    alarms \u003d system.alarm.queryStatus(state \u003d \"ActiveUnacked\", any_properties \u003d props).getDataset()\n    if alarms.getRowCount()\u003e0:\n    \tsystem.perspective.openPopup(id \u003d \"PopUpCancel\",\n\t\t\t\t\t\t\t\t\tview \u003d \"Project/Supervisor/Job Cancell/jobCancelTable\",\n\t\t\t\t\t\t\t\t\tshowCloseIcon \u003d False,\n\t\t\t\t\t\t\t\t\tdraggable \u003d False,\n\t\t\t\t\t\t\t\t\tmodal \u003d True)\n    return alarms.getRowCount()\n#    self.parent.custom.activeAlmNo \u003d alarms.getRowCount()\n#    return True if alarms.getRowCount()\u003e0 else False",
            "type": "script"
          }
        ],
        "type": "expr"
      },
      "persistent": true
    },
    "custom.Title": {
      "binding": {
        "config": {
          "path": "page.props.path"
        },
        "transforms": [
          {
            "code": "\tif value \u003d\u003d \"/opr_assist\":\n\t\treturn \"Assitance\".upper()\n\telif value \u003d\u003d \"/opr_downtime_entry\":\n\t\treturn \"Downtime Entry\".upper()\n\telif value \u003d\u003d \"/opr_job_board\":\n\t\treturn \"Job Board\".upper()\n\telif value \u003d\u003d \u0027/oee_dashboard\u0027:\n\t\treturn \"OEE DASHBOARD\".upper()\n\telif value \u003d\u003d \"/sup_downtime_monitor\":\n\t\treturn \"Downtime Logs\".upper()\n\telif value \u003d\u003d \"/opr_overview\":\n\t\treturn \"Operator Overview\".upper()\n\telif value \u003d\u003d \"/shift_overview\":\n\t\treturn \"Shift Overview\".upper()\n\telse:\n\t\treturn \"Job Board\".upper()",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.currentTheme": {
      "binding": {
        "config": {
          "bidirectional": true,
          "path": "session.props.theme"
        },
        "type": "property"
      },
      "persistent": true
    },
    "custom.sessionUser": {
      "binding": {
        "config": {
          "path": "session.props.auth.user.userName"
        },
        "type": "property"
      },
      "onChange": {
        "enabled": null,
        "script": "\troles \u003d self.props.auth.user.roles\n\tif \u0027Operator\u0027 in roles :\n\t\tsystem.perspective.sendMessage(\"opertorURL\", scope\u003d\"session\")"
      },
