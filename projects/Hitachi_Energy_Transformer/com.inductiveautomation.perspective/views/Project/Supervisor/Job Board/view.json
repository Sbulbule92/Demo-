                    "script": "#\tconnection \u003d \"Historian\"\n#\tcInfo \u003d system.db.getConnectionInfo(connection)\n\tdatabaseStatus \u003d True\n\tif databaseStatus:\n\t\ttry:\n\t\t\tparams1 \u003d {\n\t\t\t\t\"action\": \u0027success\u0027,\n\t\t\t\t\"primaryText\": \u0027Data Saved in database successfully\u0027,\n\t\t\t\t\"secondaryText\": \"Priority has been modified Successfully\"\t\t\t\n\t\t\t}\n\t\t\t\n\t#\t\tsystem.perspective.openPopup(\"PopUp\", view\u003d\u0027Project/Pop-Up/Pop-up\u0027, params\u003dparams, showCloseIcon\u003d False, draggable\u003dFalse, modal\u003d True)\n\t\t\tdata \u003d []\n#\t\t\tsystem.perspective.print(len(data))\n\t\t\tfor item in self.view.custom.RowIndexes:\n\t\t\t\tparams \u003d {\"id\":item[\"row\"],\n\t\t\t\t\t\t\"priority\":bool(item[\"value\"])}\n\t\t\t\tsystem.perspective.print(params)\n\t\t\t\tr \u003d system.db.execQuery(path\u003d \u0027Job Board/Update_Priority\u0027, parameters\u003d params)\n\t\t\t\tsystem.perspective.print(r[0][0])\n#\t\t\t\tdata.remove(item)\n#\t\t\t\tself.view.custom.RowIndexes \u003d data\n#\t\t\t\tsystem.perspective.print(len(self.view.custom.RowIndexes))\n\t\t\t\tsystem.perspective.print(item)\n\t\t\tsystem.perspective.sendMessage(\u0027refresh\u0027, scope\u003d \"page\")\n\t\t\tsystem.perspective.sendMessage(\u0027refresh1\u0027, scope\u003d \"page\")\n\t\t\tsystem.perspective.openPopup(\"PopUp\", view\u003d\u0027Project/Pop-Up/Pop-up\u0027, params\u003dparams1, showCloseIcon\u003d False, draggable\u003dFalse, modal\u003d True)\n\t\t\t\n\t\t\tself.view.custom.RowIndexes \u003d data\n\t#\t\t\t\n\t\texcept:\n\t#\t\tsystem.perspective.print(e)\n\t\t\tpass\n\telse:\n\t\tparams \u003d {\"action\": \u0027error\u0027,\"primaryText\": \u0027Database is not connected!\u0027,\"secondaryText\": \"Kindly check \u0027Historian\u0027 database connection in Gateway\"}\n\t\tsystem.perspective.openPopup(\"PopUp\",view\u003d\u0027Project/Pop-Up/Pop-up\u0027, params\u003dparams, showCloseIcon\u003d False, draggable\u003dFalse, modal\u003d True)\n\t\t\t"
