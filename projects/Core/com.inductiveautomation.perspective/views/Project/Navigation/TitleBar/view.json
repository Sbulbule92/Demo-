    "custom.Title": {
      "binding": {
        "config": {
          "path": "page.props.path"
        },
        "transforms": [
          {
            "code": "\tif value \u003d\u003d \"/opr_assist\":\n\t\treturn \"Assitance\".upper()\n\telif value \u003d\u003d \"/opr_downtime_entry\":\n\t\treturn \"Downtime Entry\".upper()\n\telif value \u003d\u003d \"/opr_job_board\":\n\t\treturn \"Job Board\".upper()\n\telif value \u003d\u003d \u0027/oee_dashboard\u0027:\n\t\treturn \"OEE DASHBOARD\".upper()\n\telif value \u003d\u003d \"/sup_downtime_monitor\":\n\t\treturn \"Downtime Logs\".upper()\n\telse:\n\t\treturn \"Job Board\".upper()",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.currentTheme": {
      "binding": {
        "config": {
          "bidirectional": true,
          "path": "session.props.theme"
        },
        "type": "property"
      },
      "persistent": true
    },
