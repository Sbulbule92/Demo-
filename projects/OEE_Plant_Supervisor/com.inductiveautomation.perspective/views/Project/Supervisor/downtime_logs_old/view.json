    "custom.date": {
      "binding": {
        "config": {
          "bidirectional": true,
          "path": "/root/FlexContainer_0/EmbeddedView.props.params.date"
        },
        "type": "property"
      },
      "onChange": {
        "enabled": null,
        "script": "\tsystem.perspective.sendMessage(messageType \u003d \u0027refreshBinding\u0027, scope\u003d\u0027page\u0027)"
