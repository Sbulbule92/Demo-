{
  "custom": {
    "instances": {
      "format": "##.0%",
      "high": 1,
      "instancePosition": {},
      "instanceStyle": {
        "classes": ""
      },
      "label": "value",
      "low": 0,
      "title": "Line 7",
      "units": "uom",
      "value": 0.5
    }
  },
  "params": {
    "instances": {
      "format": "##.0%",
      "high": 1,
      "instancePosition": {},
      "instanceStyle": {
        "classes": ""
      },
      "label": "value",
      "low": 0,
      "title": "Line 7",
      "units": "uom",
      "value": 0.5
    },
    "title": "OEE"
  },
  "propConfig": {
    "custom.instances": {
      "binding": {
        "config": {
          "path": "view.params.instances"
        },
        "type": "property"
      },
      "persistent": true
    },
    "params.instances": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.title": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 694,
      "width": 491
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "basis": "32px"
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "path": "this.props.text"
              },
              "transforms": [
                {
                  "fallback": true,
                  "inputType": "scalar",
                  "mappings": [
                    {
                      "input": "",
                      "output": false
                    }
                  ],
                  "outputType": "scalar",
                  "type": "map"
                }
              ],
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.title"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "exchange/launchpad/oee/text/header",
            "marginBottom": 10
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "FlexRepeater"
        },
        "position": {
          "basis": "320px",
          "grow": 1
        },
        "propConfig": {
          "props.instances": {
            "binding": {
              "config": {
                "path": "view.custom.instances"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "direction": "column",
          "elementPosition": {
            "basis": "30px",
            "shrink": 0
          },
          "elementStyle": {
            "margin": 0,
            "padding": 5
          },
          "path": "Exchange/Launchpad/Oee/Components/ProgressBar",
          "useDefaultViewWidth": false
        },
        "type": "ia.display.flex-repeater"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "exchange/launchpad/oee/card"
      }
    },
    "type": "ia.container.flex"
  }
}