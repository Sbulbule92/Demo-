              {
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "\t#add or edit record\n\ttableName \u003d \"ex_launchpad_oee_rate\"\n\tdatabaseName \u003d exchange.launchpad.oee.DATABASE_NAME\n\trate_name \u003d self.parent.parent.getChild(\"NameEntry\").getChild(\"TextEntry\").props.text\n\tinterval \u003d self.parent.parent.getChild(\"RateEntry\").getChild(\"Interval\").props.value\n\tuom \u003d self.parent.parent.getChild(\"RateEntry\").getChild(\"UnitsEntry\").props.text\n\ttarget_rate \u003d self.parent.parent.getChild(\"RateEntry\").getChild(\"NumericEntryField\").props.value\n\t\n\tif self.parent.parent.parent.getChild(\"AddEdit\").custom.updateMode:\n\t\t#update record\n\t\tdata \u003d {\"rate_name\": rate_name , \"uom\": uom, \"target_rate\": target_rate, \"interval\": interval}\n\t\tkey_rate_name \u003d self.parent.parent.parent.getChild(\"Table\").props.selection.data[0].rate_name\n\t\tkeys \u003d {\"rate_name\": key_rate_name }\n\t\texchange.launchpad.sql.runDatabaseUpdate(tableName, databaseName, data, keys)\n\telse:\n\t\t#add record\n\t\tdata \u003d {\"rate_name\": rate_name , \"uom\": uom, \"target_rate\": target_rate, \"interval\": interval}\n\t\texchange.launchpad.sql.runDatabaseInsert(tableName, databaseName, data)\n\tsystem.perspective.sendMessage(\"exchange-launchpad-oee-rate-mode\", payload \u003d {\"mode\": \"\"} , scope\u003d\"page\")\n\tsystem.perspective.sendMessage(\"ex-launchpad-oee-refresh-rates\", scope\u003d\"page\")\t\n\t\n\t\t\n\t\t"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
