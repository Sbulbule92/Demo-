{
  "custom": {},
  "params": {
    "labelPrinterSettings": {
      "ipAddress": "192.168.1.1",
      "name": "Printer01",
      "offsetX": 0,
      "offsetY": 0
    }
  },
  "propConfig": {
    "params.labelPrinterSettings": {
      "paramDirection": "inout",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 53,
      "width": 656
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "LblPrinterName"
        },
        "position": {
          "basis": "20%"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.labelPrinterSettings.name"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "textAlign": "center"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "NumOffsetX"
        },
        "position": {
          "basis": "20%"
        },
        "propConfig": {
          "props.value": {
            "binding": {
              "config": {
                "bidirectional": true,
                "path": "view.params.labelPrinterSettings.offsetX"
              },
              "type": "property"
            }
          }
        },
        "type": "ia.input.numeric-entry-field"
      },
      {
        "meta": {
          "name": "LblOffsetX"
        },
        "position": {
          "basis": "20%"
        },
        "props": {
          "style": {
            "paddingLeft": 10
          },
          "text": "Offset X (mm)"
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "NumOffsetY"
        },
        "position": {
          "basis": "20%"
        },
        "propConfig": {
          "props.value": {
            "binding": {
              "config": {
                "bidirectional": true,
                "path": "view.params.labelPrinterSettings.offsetY"
              },
              "type": "property"
            }
          }
        },
        "type": "ia.input.numeric-entry-field"
      },
      {
        "meta": {
          "name": "LblOffsetY"
        },
        "position": {
          "basis": "20%"
        },
        "props": {
          "style": {
            "paddingLeft": 10
          },
          "text": "Offset Y (mm)"
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "TextAddress"
        },
        "position": {
          "basis": "150px"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "bidirectional": true,
                "path": "view.params.labelPrinterSettings.ipAddress"
              },
              "type": "property"
            }
          }
        },
        "type": "ia.input.text-field"
      },
      {
        "meta": {
          "name": "LblAddress"
        },
        "position": {
          "basis": "20%"
        },
        "props": {
          "style": {
            "paddingLeft": 10
          },
          "text": "IP Address"
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "type": "ia.container.flex"
  }
}