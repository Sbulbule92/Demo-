      {
        "name": "Downtime",
        "tagType": "Folder",
        "tags": [
          {
            "valueSource": "memory",
            "name": "InsertID",
            "tagType": "AtomicTag"
          },
          {
            "name": "Ideal_time",
            "typeId": "logID",
            "tagType": "UdtInstance"
          },
          {
            "valueSource": "expr",
            "expression": "if({[.]../MachineData/ErrorActive},if(isNull({[.]StartTime}),now(),{[.]StartTime}),null)",
            "dataType": "DateTime",
            "name": "StartTime",
            "formatString": "yyyy-MM-dd h:mm:ss aa",
            "tagType": "AtomicTag"
          },
          {
            "valueSource": "expr",
            "eventScripts": [
              {
                "eventid": "valueChanged",
                "script": "\tlogger\u003d system.util.getLogger(\"downtimeevent\")\n\tif currentValue.value \u003d\u003d 10 :\n\t\t\t#breakdown in progress\n\t\t\treasondowntime\u003d16\n\t\t\tuser\u003d\u0027System\u0027\n\t\t\tstarttime\u003dsystem.tag.readBlocking([\"[.]StartTime\"])[0].value\n\t\t\tshift\u003dsystem.tag.readBlocking([\"[~]Current_Shift/shift_ID\"])[0].value\n\t\t\tparameters \u003d { \"ReasonID\":reasondowntime, \"DowntimeStatus\":True,\"username\":user,\"StartTime\":starttime,\"ShiftID\":shift} \n\t\t\t# Run the Named Query\n\t\t\tresult\u003d system.db.runNamedQuery(\"Hitachi_Energy_Transformer\",\"downtime/insert\", parameters)\n\t\t\tlogID\u003dresult[0][\"LogID\"]\n\t\t\tsystem.tag.writeBlocking(tagPaths\u003d[\"[.]Inserted\",\"[.]InsertID\"], values\u003d[1,logID])\n\telif currentValue.value \u003d\u003d 0 and not initialChange:\n\t\t\tLogID\u003dsystem.tag.readBlocking(tagPaths\u003d[\"[.]InsertID\"])[0].value\n\t\t\tparameters \u003d {\"EndTime\":system.date.now(),\"LogID\":LogID}\n\t\t\tsystem.db.runNamedQuery(\"Hitachi_Energy_Transformer\",\"downtime/Update_downtime\", parameters)\n\t\t\tsystem.tag.writeBlocking(tagPaths\u003d[\"[.]Inserted\",\"[.]InsertID\"], values\u003d[0,0])"
              }
            ],
            "expression": "if({[.]../MachineData/ErrorActive},\r\n    dateDiff(\r\n        {[.]StartTime},\r\n        now(),\r\n        \"minute\"\r\n    ),\r\n    0\r\n)\r\n",
            "name": "ActiveTime",
            "tagType": "AtomicTag"
          },
          {
            "valueSource": "reference",
            "dataType": "Boolean",
            "sourceTagPath": "[.]../MachineData/ErrorActive",
            "name": "Active",
            "tagType": "AtomicTag"
          },
          {
            "valueSource": "memory",
            "dataType": "Boolean",
            "name": "Inserted",
            "value": false,
            "tagType": "AtomicTag"
          }
        ]
      },
