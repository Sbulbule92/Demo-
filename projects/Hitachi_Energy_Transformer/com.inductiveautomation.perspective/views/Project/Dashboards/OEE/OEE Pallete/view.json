          "returnFormat": "json"
        },
        "transforms": [
          {
            "code": "\timport random\n\tval \u003d 0\n\tfor item in value:\n\t\tdiff \u003d item[\u0027actualCT\u0027]-item[\u0027idealCT\u0027]\n\t\tval \u003d val + diff\n\tr \u003d random.randint(60,80)\n\treturn val/r if val \u003e 100 else val",
            "type": "script"
          }
        ],
        "type": "query"
      },
      "persistent": true
    },
