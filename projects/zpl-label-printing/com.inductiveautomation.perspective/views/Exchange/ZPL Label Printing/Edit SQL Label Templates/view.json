        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\t# retrieve labelZPL from database\n\tgetLabelFromSQL \u003d \"\"\"\n\t\tselect label_name, label_zpl\n\t\tfrom ex_zpl_label_printing.ex_zlp_label_templates \n\t\twhere label_name \u003d ?\n\t\"\"\"\n\tlabelName \u003d self.props.value\n\tlabel_DS \u003d system.db.runPrepQuery(getLabelFromSQL, [labelName], \u0027ex_zpl_label_printing\u0027) \n\t\n\tif label_DS.getRowCount() \u003e 0:\n\t\tlabelZPL \u003d label_DS.getValueAt(0, \u0027label_zpl\u0027)\n\telse:\n\t\tlabelZPL \u003d \u0027\u0027\n\t\n\t# then send message to be received by ImageOfLabel component message handler\n\tlabelInfo \u003d {}\n\tlabelInfo[\u0027labelZPL\u0027] \u003d labelZPL\n\tsystem.perspective.sendMessage(\u0027exchange.zplLabelPrinting.getLabelaryImage\u0027, scope\u003d\u0027page\u0027, payload\u003dlabelInfo)\n\t\n\t\n\t"
              },
              "scope": "G",
              "type": "script"
            }
          },
          "system": {
            "onStartup": {
              "config": {
                "script": "\t# populate dropdown menu with sql label names on start\n\tsystem.perspective.sendMessage(\u0027exchange.zplLabelPrinting.refreshLabelNames\u0027, scope\u003d\u0027page\u0027)"
              },
              "scope": "G",
              "type": "script"
            }
          }
