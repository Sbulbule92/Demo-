{
  "custom": {},
  "params": {
    "LogID": "value",
    "ReasonID": "value",
    "ReasonName": "value",
    "icon": "published_with_changes",
    "label": "value"
  },
  "propConfig": {
    "params.LogID": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.ReasonID": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.ReasonName": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.icon": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.label": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 85.380950928,
      "width": 349
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Icon"
        },
        "position": {
          "basis": "50px"
        },
        "propConfig": {
          "props.path": {
            "binding": {
              "config": {
                "expression": "\"material/\" + {view.params.icon}"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "marginLeft": "5px"
          }
        },
        "type": "ia.display.icon"
      },
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.label"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "fontFamily": "verdana",
            "fontSize": "20px",
            "fontWeight": "500",
            "paddingLeft": "10px"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "events": {
      "dom": {
        "onClick": {
          "config": {
            "script": "\tselectedReasonID\u003dself.view.params.ReasonID\n\tselectedReasonName\u003dself.view.params.label\n\tlogid \u003d self.view.params.LogID\n\tparams\u003d{\"reasonID\":selectedReasonID,\"reasonValue\":selectedReasonName, \"logID\": logid}\n\tsystem.perspective.openPopup(\u0027dtconfirm\u0027, \n\t\t\t\t\t\t\t\t\tview \u003d \u0027Project/Operator/Operator/downtime_entry_popup_confirm\u0027,\n\t\t\t\t\t\t\t\t\tparams\u003dparams, title \u003d \"Downtime Reason Update\", \n\t\t\t\t\t\t\t\t\tmodal \u003d True)\n\tsystem.perspective.closePopup(\u002710UI\u0027)\n\n"
          },
          "scope": "G",
          "type": "script"
        }
      }
    },
    "meta": {
      "name": "root"
    },
    "props": {
      "style": {
        "backgroundColor": "--neutral-30",
        "borderBottomLeftRadius": "10px",
        "borderBottomRightRadius": "10px",
        "borderTopLeftRadius": "10px",
        "borderTopRightRadius": "10px",
        "classes": "downtime",
        "color": "--neutral-80",
        "cursor": "pointer"
      }
    },
    "type": "ia.container.flex"
  }
}