          {
            "meta": {
              "name": "MdInstructions"
            },
            "position": {
              "height": 45,
              "width": 280,
              "x": 620,
              "y": 130
            },
            "props": {
              "source": "Please use this page to adjust printer settings for each label printer."
            },
            "type": "ia.display.markdown"
          },
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\t# get printer data from data entry fields\n\tprinterName \u003d self.getSibling(\"TextPrinterName\").props.text\n\tipAddress \u003d self.getSibling(\"TextAddress\").props.text\n\toffsetX \u003d self.getSibling(\"NumOffsetX\").props.value\n\toffsetY \u003d self.getSibling(\"NumOffsetY\").props.value\n\t\n\t# also get list of existing printer names from table\n\tprinterNames \u003d []\n\tprinterDS \u003d self.getSibling(\"TablePrinterSettings\").props.data\n\tfor row in range(printerDS.getRowCount()):\n\t\tprinterNames.append(printerDS.getValueAt(row, \u0027printer_name\u0027))\n\t\n\t# update printer settings if printer name already exists. Otherwise add new one.\n\t# postgresql database connection in Ignition gateway is named \u0027ex_zpl_label_printing\u0027\n\tif printerName in printerNames:\n\t\tupdatePrinter \u003d \"\"\"\n\t\t\tupdate ex_zpl_label_printing.ex_zlp_label_printer_settings\n\t\t\tset printer_name \u003d ?, ip_address \u003d ?, offset_x_mm \u003d ?, offset_y_mm \u003d ?\n\t\t\twhere printer_name \u003d ?\n\t\t\"\"\"\n\t\tprinterData \u003d [ printerName, ipAddress, offsetX, offsetY, printerName ]\n\t\tr \u003d system.db.runPrepUpdate(updatePrinter, printerData, \u0027ex_zpl_label_printing\u0027)\n\t\t\n\t\tsystem.perspective.sendMessage(\u0027exchange.zplLabelPrinting.refreshPrinterSettings\u0027, scope\u003d\u0027page\u0027)\n\t\texchange.zplLabelPrinting.popup.displayMessage(\u0027Printer Updated\u0027, \u0027Successfully updated existing printer!\u0027)\n\t\t\n\telse:\n\t\taddPrinter \u003d \"\"\"\n\t\t\tinsert into ex_zpl_label_printing.ex_zlp_label_printer_settings\n\t\t\t(printer_name, ip_address, offset_x_mm, offset_y_mm)\n\t\t\tvalues (?, ?, ?, ?)\n\t\t\"\"\"\n\t\tprinterData \u003d [ printerName, ipAddress, offsetX, offsetY ]\n\t\tr \u003d system.db.runPrepUpdate(addPrinter, printerData, \u0027ex_zpl_label_printing\u0027)\n\t\n\t\tsystem.perspective.sendMessage(\u0027exchange.zplLabelPrinting.refreshPrinterSettings\u0027, scope\u003d\u0027page\u0027)\n\t\texchange.zplLabelPrinting.popup.displayMessage(\u0027Printer Added\u0027, \u0027Successfully added new printer!\u0027)\n\t\n\t\n\t"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "BtnPrinterAddUpdate"
            },
            "position": {
              "height": 45,
              "width": 135,
              "x": 910,
              "y": 130
            },
            "props": {
              "style": {
                "classes": "Components/brownButtons"
