  "params": {},
  "propConfig": {
    "custom.icon": {
      "persistent": true
    },
    "custom.reasons": {
      "binding": {
        "config": {
          "queryPath": "utility/dropdown/GetDowntimeReasonCodes",
          "returnFormat": "json"
        },
        "transforms": [
          {
            "code": "\ticons \u003d self.custom.icon\n\tdata \u003d []\n\tfor i in range(0, len(value)):\n\t\tval \u003d {\"label\": value[i][\u0027label\u0027], \"icon\":icons[i],\"ReasonID\":value[i][\u0027value\u0027]}\n\t\tdata.append(val)\n\treturn data",
            "type": "script"
          }
        ],
        "type": "query"
      },
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 804,
      "width": 1270
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Label"
            },
            "position": {
              "basis": "700px",
              "grow": 1
            },
            "props": {
              "style": {
                "backgroundColor": "--neutral-30"
              },
              "text": "SELECT DOWNTIME REASON",
              "textStyle": {
                "alignSelf": "center",
                "fontFamily": "Verdana",
                "fontSize": "26px",
                "fontWeight": "bold",
                "margin-top": "0px",
                "padding": "30px"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "FlexRepeater"
            },
            "position": {
              "basis": "1300px"
            },
            "propConfig": {
              "props.instances": {
                "binding": {
                  "config": {
                    "path": "view.custom.reasons"
                  },
                  "transforms": [
                    {
                      "code": "\t\n\tshift\u003dsystem.tag.readBlocking([\"Current_Shift/Start_time\",\"Current_Shift/End_time\"])\n\tcurrentshiftstarttime\u003dshift[0].value\n\tcurrentshiftendtime\u003dshift[1].value\n\tMachineID\u003dself.session.custom.machineInfo.ID\n\tparameters \u003d {\"startTime\":currentshiftstarttime,\"endTime\":currentshiftendtime,\"MachineID\":MachineID} \n\tlunchexistsds\u003dsystem.db.runNamedQuery(\"downtime/CheckActiveLunch\", parameters)\n\tlunchexist\u003dlunchexistsds.getValueAt(0,0)\n\tif lunchexist:\n\t\tfiltered \u003d [r for r in value if r.get(\"ReasonID\") !\u003d 9]\n   \t\treturn filtered\n\telse:\n\t\treturn value",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "alignItems": "center",
              "elementPosition": {
                "basis": "auto"
              },
              "elementStyle": {
                "margin": "15px"
              },
              "justify": "center",
              "path": "Project/Operator/Downtime Entry/Downtime Select",
              "wrap": "wrap"
            },
            "type": "ia.display.flex-repeater"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "page": "/opr_assist"
                  },
                  "scope": "C",
                  "type": "nav"
                }
              }
            },
            "meta": {
              "name": "Button"
            },
