      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\t# send ip address over payload to message handler on icon for printer connection status\n\tip \u003d  self.props.value\n\tipToPing \u003d { \u0027ip\u0027 : ip }\n\tsystem.perspective.sendMessage(\u0027exchange.zplLabelPrinting.getPrinterConnectionStatus\u0027, payload\u003dipToPing)"
              },
              "scope": "G",
              "type": "script"
            }
