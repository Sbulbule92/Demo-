          "script": "#\tuser\u003dself.session.props.auth.user.userName\n#\tmachineName\u003dself.session.custom.machine\n#\treasondowntime\u003d16\n#\tuser\u003d\u0027System\u0027\n#\tinprogressdowntime\u003dFalse\n#\t#starttime\u003dsystem.date.now()\n#\tbasePath \u003dmachineName\n#\ttagpath\u003d[\"Current_Shift/shift_ID\",\"{}/Machineinfo/LineID\".format(basePath),\"{}/Machineinfo/MachineID\".format(basePath),\"{}/Downtime/Ideal_time/Start_time\".format(basePath)]\n#\ttagvalue\u003dsystem.tag.readBlocking(tagpath)\n#\tshift\u003dtagvalue[0].value\n#\tLineID\u003dtagvalue[1].value\n#\tMachineID\u003dtagvalue[2].value\n#\tstarttime\u003dtagvalue[3].value\n#\tdescdowntime\u003d\u0027\u0027\n#\tparameters \u003d { \"ReasonID\":reasondowntime, \"DowntimeStatus\":not inprogressdowntime,\"username\":user,\"StartTime\":starttime,\"ShiftID\":shift,\"DowntimeSource\":1,\"Remarks\":descdowntime,\"categoryID\":2,\"LineID\":LineID,\"MachineID\":MachineID}\n#\tidreturn\u003dsystem.db.runNamedQuery(\"downtime/InsertDowntimeEntry\", parameters)\n#\tlogId\u003didreturn.getValueAt(0,\"LogID\")\n#\tsystem.tag.writeBlocking(tagPaths\u003d[\"{}/Downtime/Ideal_time/logID\".format(basePath),\"{}/Downtime/Ideal_time/log_Active\".format(basePath)], values\u003d[logId,1])\n\tsystem.perspective.logout(\"Please Login from recongnised device\")",
