{
  "custom": {
    "Title": "JOB BOARD",
    "currentTheme": "light-cool"
  },
  "params": {},
  "propConfig": {
    "custom.Title": {
      "binding": {
        "config": {
          "path": "page.props.path"
        },
        "transforms": [
          {
            "code": "\tif value \u003d\u003d \"/opr_assist\":\n\t\treturn \"ASSISTANCE\"\n\telif value \u003d\u003d \"/opr_downtime_entry\":\n\t\treturn \"DOWNTIME ENTRY\"\n\telif value \u003d\u003d \"/opr_job_board\" or value \u003d\u003d\"/\":\n\t\treturn \"JOB BOARD\"\n\telif value \u003d\u003d \u0027/oee_dashboard\u0027:\n\t\treturn \"OEE DASHBOARD\"\n\telif value \u003d\u003d \u0027/home\u0027:\n\t\treturn \"OPERATOR JOB BOARD\"\n\telif value \u003d\u003d \u0027/wip\u0027:\n\t\treturn \"WORK IN PROGRESS\"\n\telif value \u003d\u003d \u0027/opr_overview\u0027 or value \u003d\u003d \"/opr_overview_detailed\":\n\t\treturn \"OPERATOR OVERVIEW\"\n\telif value \u003d\u003d \"/sup_downtime_monitor\":\n\t\treturn \"DOWNTIME LOGS\"",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "custom.currentTheme": {
      "binding": {
        "config": {
          "bidirectional": true,
          "path": "session.props.theme"
        },
        "type": "property"
      },
      "persistent": true
    }
  },
