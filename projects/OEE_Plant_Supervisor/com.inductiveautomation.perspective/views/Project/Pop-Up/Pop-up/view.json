              },
              "props.textStyle.color": {
                "binding": {
                  "config": {
                    "path": "view.custom.styles[0].primaryButtonColor"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "primary": false,
              "style": {
                "borderStyle": "solid",
                "classes": "Project/PopUp/Button"
              },
              "text": "CANCLE"
            },
            "type": "ia.input.button"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\t\t\t\t\t\t\t\t\n\tif self.view.params.label \u003d\u003d \"manual downtime\" and str(self.view.params.action).lower() \u003d\u003d \"success\" :\n\t\tsystem.perspective.closePopup(\u0027PopUp\u0027)\n#\t\tsystem.perspective.navigate(page\u003d\"/opr_job_board\")\n\telse:\n\t\tsystem.perspective.closePopup(\u0027PopUp\u0027)\n\t\t#pas"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "Accept Button"
            },
            "position": {
              "basis": "150px"
            },
            "propConfig": {
              "props.style.backgroundColor": {
                "binding": {
