                {
                  "messageType": "exchange.zplLabelPrinting.getPrinterConnectionStatus",
                  "pageScope": true,
                  "script": "\t# use os library to ping printer IP, ping count 2\n\timport os\n\t\n\tstatus \u003d \u0027material/swap_vertical_circle\u0027\n\tself.props.path \u003d status\n\t\n\tip \u003d payload[\u0027ip\u0027]\n\tconnected \u003d os.system(\"ping /n 2 \" + str(ip)) \u003d\u003d 0 # Windows 10, 11, Server 2016+\n\t#connected \u003d os.system(\"ping -c 2 \" + str(ip)) \u003d\u003d 0 # OS X or Linux\n\t\n\tif connected \u003d\u003d True:\n\t\tstatus \u003d \u0027material/check_circle\u0027\n\telse:\n\t\tstatus \u003d \u0027material/cancel\u0027\n\t\n\tself.props.path \u003d status",
                  "sessionScope": false,
                  "viewScope": false
                }
              ]
            },
            "type": "ia.display.icon"
          }
