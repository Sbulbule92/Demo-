  },
  "propConfig": {
    "custom.color": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "transforms": [
          {
            "fallback": "#9CA3AF",
            "inputType": "scalar",
            "mappings": [
              {
                "input": 2,
                "output": "#9CA3AF"
              },
              {
                "input": 4,
                "output": "--success"
              },
              {
                "input": 8,
                "output": "#F59E0b"
              },
              {
                "input": 32,
