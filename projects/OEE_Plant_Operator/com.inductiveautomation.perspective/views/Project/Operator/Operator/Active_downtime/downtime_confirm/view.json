              {
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "\t#categorydowntime \u003dself.parent.parent.getChild(\"down_cat_flex\").getChild(\"Dropdown\").props.value\n\tmachineID\u003dself.session.custom.machineInfo.ID\n\tlineID\u003dself.session.custom.machineInfo.lineID\n\treasondowntime \u003d self.parent.parent.getChild(\"Reasonflex\").getChild(\"Dropdown\").props.value\n\tinprogressdowntime\u003dself.parent.parent.getChild(\"downtime_inprogress_flex\").getChild(\"Checkbox\").props.selected\n\tstarttime\u003dself.parent.parent.getChild(\"Start_time_flex\").getChild(\"DateTimeInput\").props.value\n\tEndTime\u003dself.parent.parent.getChild(\"Endtime_flex_0\").getChild(\"DateTimeInput\").props.value\n\tshift\u003dsystem.tag.readBlocking(\"[default]Current_Shift/shift_ID\")[0].value\n\tdescdowntime\u003dself.parent.parent.getChild(\"downtime_desc_flex\").getChild(\"TextArea\").props.text\n\tbasePath\u003dself.session.custom.machineInfo.basePath\n\tlogID\u003dself.view.getChild(\"root\").custom.LogID\n\tuser\u003dself.session.props.auth.user.userName\n\tDowtimeSource\u003dself.view.getChild(\"root\").custom.DowtimeSource\n\terrorcode\u003d\u0027\u0027\n\tdtstatus\u003d2\n#\tif categorydowntime \u003c 1 :\n#\t\terrorcode\u003d \"Please select a Downtime category\"\n\tif reasondowntime \u003c 1 :\n\t\terrorcode\u003d \"Please select a Downtime reason\"\n\telif starttime is None :\n\t\terrorcode\u003d \"Please select start time\"\n#\telif inprogressdowntime \u003d\u003d False and EndTime is None:\n#\t\terrorcode\u003d \"Please select end time\"\n\telif len(descdowntime) \u003c\u003d 4 and  reasondowntime \u003d\u003d 15:\n\t\terrorcode\u003d \"Please provide downtime description \"\n\telif inprogressdowntime \u003d\u003d False and EndTime \u003e system.date.now():\n\t\terrorcode\u003d \"End date should be less than current time\"\n\telif starttime \u003e system.date.now():\n\t\terrorcode\u003d \"Start date should be less than current time\"\t\t\n\telse:\n\t\t\n\t\tif DowtimeSource \u003d\u003d 1 :\n\t\t\tparameters \u003d {\"logID\":logID, \"ReasonID\":reasondowntime,\"remark\":descdowntime, \"user\": user} \n\t\t\tsystem.db.runNamedQuery(\"downtime/Updatedowntimereason\", parameters)\n\t\t\tsystem.perspective.closePopup(id\u003d\"Popup\")\n\t\t\tdtstatus\u003d1\n\t\telse:\n\t\t\tif inprogressdowntime :\n\t\t\t\tparameters \u003d {\"logID\":logID, \"ReasonID\":reasondowntime,\"remark\":descdowntime, \"user\": user} \n\t\t\t\treturndata\u003dsystem.db.runNamedQuery(\"downtime/Updatedowntimereason\", parameters)\n\t\t\t\tif returndata \u003d\u003d 0:\n\t\t\t\t\tdtstatus\u003d2\n\t\t\t\telse:\n\t\t\t\t\tdtstatus\u003d1\n\t\t\t\tsystem.perspective.closePopup(id\u003d\"Popup\")\n\t\t\telse :\n\t\t\t\tparameters \u003d {\"ReasonID\":reasondowntime,\"user\":user,\"EndDate\":EndTime,\"remark\":descdowntime,\"logID\":logID} \n\t\t\t\treturndata\u003dsystem.db.runNamedQuery(\"downtime/Update_Manual_Dowtime\", parameters)\n\t\t\t\tif returndata \u003d\u003d 0:\n\t\t\t\t\tdtstatus\u003d2\n\t\t\t\telse:\n\t\t\t\t\tdtstatus\u003d1\n\t\t\t\t\tsystem.tag.writeBlocking([basePath+\"/Downtime/Ongoingbreakdown\",basePath+\"/Downtime/Manual_entry_Active\"],[False,False])\n\t\t\t\t\tsystem.perspective.closePopup(id\u003d\"Popup\")\n\t\tif dtstatus \u003d\u003d 1:\n\t\t\tparams \u003d {\"action\": \"success\", \"primaryText\": \"Downtime logged successfully!\", \"secondaryText\":\"\",\"label\":\"manual downtime\"}\n\t\t\tsystem.perspective.openPopup(\"PopUp\", view \u003d \"Project/Pop-Up/Pop-up\", \n\t\t\t\t\t\t\t\t\t\t\tparams \u003d params, \n\t\t\t\t\t\t\t\t\t\t\tshowCloseIcon \u003d False,\n\t\t\t\t\t\t\t\t\t\t\tdraggable \u003d False, \n\t\t\t\t\t\t\t\t\t\t\tmodal \u003d True)\n\t\telif dtstatus \u003d\u003d 0:\n\t\t\tparams \u003d {\"action\": \"error\", \"primaryText\": \"Downtime Already exists!\", \"secondaryText\":\"\",\"label\":\"manual downtime\"}\n\t\t\tsystem.perspective.openPopup(\"PopUp\", view \u003d \"Project/Pop-Up/Pop-up\", \n\t\t\t\t\t\t\t\t\t\t\t\t\t\tparams \u003d params, \n\t\t\t\t\t\t\t\t\t\t\t\t\t\tshowCloseIcon \u003d False,\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tdraggable \u003d False, \n\t\t\t\t\t\t\t\t\t\t\t\t\t\tmodal \u003d True)\n\t\telif  dtstatus \u003d\u003d 2:\n\t\t\tparams \u003d {\"action\": \"error\", \"primaryText\": \"Something went Wrong!\", \"secondaryText\":\"\",\"label\":\"manual downtime\"}\n\t\t\tsystem.perspective.openPopup(\"PopUp\", view \u003d \"Project/Pop-Up/Pop-up\", \n\t\t\t\t\t\t\t\t\t\t\t\t\t\tparams \u003d params, \n\t\t\t\t\t\t\t\t\t\t\t\t\t\tshowCloseIcon \u003d False,\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tdraggable \u003d False, \n\t\t\t\t\t\t\t\t\t\t\t\t\t\tmodal \u003d True)\n\tself.getSibling(\"Label\").props.text\u003d errorcode\n\t#system.perspective.navigate(url\u003d\"http://localhost:8088/data/perspective/client/Shiva_Hitachi/opr_job_board\")"
                      },
