          "transforms": [
            {
              "code": "\tsystem.perspective.sendMessage(messageType\u003d\"refreshBoard\", payload\u003d{}, scope\u003d\"page\")\n\treturnresult \u003d system.tag.readBlocking([\"Ignition_Project_Config/Opr_updated_wo\",\"Ignition_Project_Config/Sup_updated_wo\",\"ECS_Sync/Update_wo\"])\n\tif returnresult[0].value \u003d\u003dTrue:\n\t\tsystem.tag.writeBlocking([\"Ignition_Project_Config/Opr_updated_wo\"],[False])\n\tif returnresult[1].value \u003d\u003dTrue:\n\t\tsystem.tag.writeBlocking([\"Ignition_Project_Config/Sup_updated_wo\"],[False])\n\tif returnresult[2].value \u003d\u003dTrue:\n\t\tsystem.tag.writeBlocking([\"ECS_Sync/Update_wo\"],[False])\t\n\treturn value",
              "type": "script"
            }
          ],
          "type": "expr"
        }
