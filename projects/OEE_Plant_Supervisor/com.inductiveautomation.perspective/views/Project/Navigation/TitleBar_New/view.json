          "script": "\t# implement your handler here\n\tparams \u003d {\"label\":\"Lunch Break\"}\n\tsystem.perspective.openPopup(id\u003d\u0027PopUp\u0027,view\u003d\u0027Project/Pop-Up/Lunch\u0027,params \u003d params, showCloseIcon\u003dFalse,modal\u003dTrue)",
