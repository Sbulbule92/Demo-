          "returnFormat": "dataset"
        },
        "transforms": [
          {
            "code": "\timport random\n\ttry:\n\t\tdata \u003d []\n\t\tfor row in value:\n\t\t    row_dict \u003d {}\n\t\t    for col in value.getColumnNames():\n\t\t        row_dict[col] \u003d row[col]\n\t\t    data.append(row_dict)\n\t\t\n\t\t# Now this works\n\t\tkeys \u003d data[0].keys()\n\t\tlst \u003d []\n\t\t\n\t\tfor i in keys:\n\t\t\tcol \u003d {\n\t\t\t  \"field\": i,\n\t\t\t  \"render\": \"auto\" if i !\u003d \"StartTime\" or i!\u003d\u0027EndTime\u0027 else date,\n\t\t\t  \"justify\": \"center\",\n\t\t\t  \"align\": \"center\",\n\t\t\t  \"header\": {\n\t\t\t    \"title\": i,\n\t\t\t    \"justify\": \"center\",\n\t\t\t    \"align\": \"center\",\n\t\t\t    \"style\": {\n\t\t\t      \"classes\": \"\"\n\t\t\t    }\n\t\t\t  }\n\t\t\t}\n\t\t\tlst.append(col)\n\t\tself.custom.cols \u003d lst if len(lst)\u003e0 else []\n\t\tfor row in range(value.rowCount):\n\t\t\tr \u003d random.randint(0,14)\n\t\t\tvalue \u003d system.dataset.setValue(value, row, \u0027Remarks\u0027, self.custom.reasons[r].ReasonName)\n\t\treturn value\n\texcept:\n\t\tpass\n\t",
            "type": "script"
          }
        ],
        "type": "query"
      },
      "persistent": true
    },
